# URL del API consumida por el navegador. /api usa el proxy local de Vite.
VITE_API_BASE_URL=/api

# Destino del proxy exclusivamente durante desarrollo local.
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:3000

# La URL y anon key son publicas y se reservaran para Supabase Auth.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# PROHIBIDO: nunca declarar SUPABASE_SERVICE_ROLE_KEY con prefijo VITE_.

