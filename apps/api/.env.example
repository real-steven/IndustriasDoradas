# Entorno del proceso: development, test o production.
NODE_ENV=development

# Puerto HTTP local del API.
PORT=3000

# URL publica del proyecto Supabase; tambien determina issuer y JWKS de Auth.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# SECRETO EXCLUSIVO DEL API. Sustituir solo en .env.local o gestor de secretos.
# Nunca copiar a VITE_*, desktop, documentacion, capturas ni Git.
SUPABASE_SECRET_KEY=YOUR_BACKEND_ONLY_KEY_REPLACE_LOCALLY
