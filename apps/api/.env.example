# Entorno del proceso: development, test o production.
NODE_ENV=development

# Puerto HTTP local del API.
PORT=3000

# URL publica del proyecto Supabase. Se habilitara cuando se integre Supabase.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Clave publica anon de Supabase. No concede privilegios administrativos.
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# SECRETO EXCLUSIVO DEL API. Sustituir solo en .env.local o gestor de secretos.
# Nunca copiar a VITE_*, desktop, documentacion, capturas ni Git.
SUPABASE_SERVICE_ROLE_KEY=YOUR_PRIVATE_SERVICE_ROLE_KEY

