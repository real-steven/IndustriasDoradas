{
  "Api": {
    "RequestTimeoutSeconds": 5
  },
  "LocalDatabase": {
    "BusyTimeoutSeconds": 5
  },
  "OperationInput": {
    "Controllers": [
      {
        "Id": "shared-keyboard",
        "AdapterKind": "KEYBOARD",
        "LineSlot": 1,
        "Bindings": {
          "D1": "SelectLine:1",
          "Add": "RegisterCajuela",
          "OemPlus": "RegisterCajuela",
          "Up": "MoveUp",
          "Down": "MoveDown",
          "Left": "MoveLeft",
          "Right": "MoveRight",
          "Return": "Confirm",
          "R": "RevertLastCajuela",
          "Escape": "Cancel"
        }
      }
    ]
  },
  "OperationSafety": {
    "DebounceMilliseconds": 75,
    "RegistrationCooldownMilliseconds": 3000,
    "VisualFeedbackEnabled": true,
    "SoundFeedbackEnabled": true,
    "MetricsEnabled": true,
    "MetricsQueueCapacity": 1000
  },
  "LocalRecovery": {
    "MinimumFreeMegabytes": 256
  },
  "Sync": {
    "BatchSize": 10,
    "RequestTimeoutSeconds": 30,
    "PollIntervalSeconds": 5,
    "LeaseSeconds": 60,
    "BaseRetrySeconds": 2,
    "MaximumRetrySeconds": 300,
    "JitterRatio": 0.25
  }
}
