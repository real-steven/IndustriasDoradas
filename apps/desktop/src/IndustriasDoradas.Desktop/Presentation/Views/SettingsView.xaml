<UserControl x:Class="IndustriasDoradas.Desktop.Presentation.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Configuración de estación">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource SoftCanvasBrush}">
        <StackPanel Margin="34,26,34,42" MaxWidth="1380" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Foreground="#2F7EA4" FontSize="11" FontWeight="Bold"
                           Text="PREFERENCIAS DE LA ESTACIÓN" />
                <TextBlock Margin="0,7,0,0" FontSize="28" FontWeight="Bold" Text="Configuración" />
                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"
                           Text="Opciones protegidas para adaptar la estación y sus dispositivos." />
            </StackPanel>

            <Border Margin="0,18,0,0" Style="{StaticResource WarningAlertStyle}">
                <TextBlock AutomationProperties.LiveSetting="Polite" Text="{Binding Status}" TextWrapping="Wrap" />
            </Border>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="5*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="26" Style="{StaticResource SurfaceCardStyle}">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe UI Emoji" FontSize="36" Text="⌨" />
                        <TextBlock Margin="0,13,0,0" FontSize="22" FontWeight="Bold"
                                   Text="Controles de teclado" />
                        <TextBlock Margin="0,7,0,18" Foreground="{StaticResource MutedBrush}"
                                   LineHeight="20" TextWrapping="Wrap"
                                   Text="Permitirá asignar teclas a las acciones disponibles durante el futuro Modo teclado." />

                        <Border Padding="16" Background="#F7F9FA" CornerRadius="11">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" Text="Acciones que podrán configurarse" />
                                <TextBlock Margin="0,10,0,0" Text="• Seleccionar Línea 1, 2, 3 o 4" />
                                <TextBlock Margin="0,6,0,0" Text="• Agregar cajuela a la línea seleccionada" />
                                <TextBlock Margin="0,6,0,0" Text="• Solicitar corrección de la última cajuela" />
                                <TextBlock Margin="0,6,0,0" Text="• Registrar barrida cuando esté disponible" />
                                <TextBlock Margin="0,6,0,0" Text="• Confirmar o cancelar una advertencia" />
                                <TextBlock Margin="0,6,0,0" FontWeight="Bold"
                                           Text="• Esc — salir del modo teclado; no configurable" />
                            </StackPanel>
                        </Border>

                        <Button Margin="0,18,0,0" HorizontalAlignment="Left"
                                Command="{Binding ShowComingSoonCommand}"
                                CommandParameter="personalizar las teclas del Modo teclado"
                                Content="CONFIGURAR TECLAS · PRÓXIMAMENTE" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Padding="21" Style="{StaticResource SurfaceCardStyle}" CornerRadius="16">
                        <StackPanel>
                            <TextBlock FontFamily="Segoe UI Emoji" FontSize="28" Text="🔊" />
                            <TextBlock Margin="0,10,0,0" FontSize="17" FontWeight="Bold" Text="Sonidos y respuesta" />
                            <TextBlock Margin="0,5,0,12" Foreground="{StaticResource MutedBrush}"
                                       Text="Ajustará sonidos de éxito, error y volumen de la estación." TextWrapping="Wrap" />
                            <Button HorizontalAlignment="Left" Command="{Binding ShowComingSoonCommand}"
                                    CommandParameter="personalizar sonidos y respuesta visual"
                                    Content="PRÓXIMAMENTE" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,12,0,0" Padding="21" Style="{StaticResource SurfaceCardStyle}"
                            CornerRadius="16">
                        <StackPanel>
                            <TextBlock FontFamily="Segoe UI Emoji" FontSize="28" Text="▣" />
                            <TextBlock Margin="0,10,0,0" FontSize="17" FontWeight="Bold" Text="Modo teclado" />
                            <TextBlock Margin="0,5,0,12" Foreground="{StaticResource MutedBrush}"
                                       Text="Mostrará únicamente las líneas activas y aceptará las teclas autorizadas. Esc permitirá salir." TextWrapping="Wrap" />
                            <Button HorizontalAlignment="Left" Command="{Binding ShowComingSoonCommand}"
                                    CommandParameter="activar el Modo teclado restringido"
                                    Content="PRÓXIMAMENTE" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,12,0,0" Padding="21" Style="{StaticResource SurfaceCardStyle}"
                            CornerRadius="16">
                        <StackPanel>
                            <TextBlock FontFamily="Segoe UI Emoji" FontSize="28" Text="⌁" />
                            <TextBlock Margin="0,10,0,0" FontSize="17" FontWeight="Bold" Text="Sensores y dispositivos" />
                            <TextBlock Margin="0,5,0,12" Foreground="{StaticResource MutedBrush}"
                                       Text="Reservado para integrar sensores físicos sin cambiar la operación manual." TextWrapping="Wrap" />
                            <Button HorizontalAlignment="Left" Command="{Binding ShowComingSoonCommand}"
                                    CommandParameter="configurar sensores y dispositivos físicos"
                                    Content="PRÓXIMAMENTE" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
