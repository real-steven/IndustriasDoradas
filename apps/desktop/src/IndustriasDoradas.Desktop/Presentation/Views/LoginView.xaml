<UserControl x:Class="IndustriasDoradas.Desktop.Presentation.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Inicio de sesión de estación">
    <Grid Width="800" Height="570" Background="White" ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#14384C" />
                            <GradientStop Offset="1" Color="#245A73" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid ClipToBounds="True">
                        <Canvas IsHitTestVisible="False">
                            <Ellipse Width="330" Height="330" Canvas.Left="52" Canvas.Top="350"
                                     Stroke="#2B6076" StrokeThickness="34" Opacity="0.48" />
                            <Ellipse Width="230" Height="230" Canvas.Left="103" Canvas.Top="405"
                                     Stroke="#376F84" StrokeThickness="22" Opacity="0.38" />
                        </Canvas>

                        <Grid Margin="32,38">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Border Width="52" Height="52" CornerRadius="15" ClipToBounds="True">
                                    <Image Source="pack://application:,,,/Assets/logo-industrias-doradas.png"
                                           Stretch="UniformToFill"
                                           AutomationProperties.Name="Logo de Industrias Doradas" />
                                </Border>
                                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Foreground="White" FontSize="18" FontWeight="Bold"
                                               Text="INDUSTRIAS" />
                                    <TextBlock Foreground="White" FontSize="18" FontWeight="Bold"
                                               Text="DORADAS" />
                                    <TextBlock Margin="0,3,0,0" Foreground="#D8E8EE" FontSize="11"
                                               Text="Sistema de planta" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <TextBlock Foreground="#F2C56B" FontSize="11" FontWeight="Bold"
                                           Text="ESTACIÓN DE PLANTA" />
                                <TextBlock Margin="0,13,0,0" Foreground="White" FontSize="29"
                                           FontWeight="Bold" LineHeight="34" TextWrapping="Wrap"
                                           Text="Operación lista para comenzar." />
                                <TextBlock Margin="0,14,0,0" Foreground="#D6E5EA" FontSize="12"
                                           LineHeight="19" TextWrapping="Wrap"
                                           Text="Un único acceso abre la estación para los operarios y mantiene la actividad protegida." />
                            </StackPanel>

                            <Border Grid.Row="2" Padding="13,11" Background="#245269"
                                    BorderBrush="#4C788A" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="9" Height="9" Margin="0,2,10,0" VerticalAlignment="Top"
                                             Fill="{Binding LoginSessionColor}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold"
                                                   Text="{Binding LoginSessionTitle}" TextWrapping="Wrap"
                                                   AutomationProperties.LiveSetting="Polite" />
                                        <TextBlock Margin="0,3,0,0" Foreground="#C7DDE5" FontSize="9"
                                                   Text="{Binding LoginSessionDescription}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="50,46">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Foreground="#2F7EA4" FontSize="10" FontWeight="Bold"
                                   Text="ACCESO PROTEGIDO" />
                        <TextBlock Margin="0,11,0,0" Foreground="{StaticResource Ink900Brush}"
                                   FontSize="30" FontWeight="Bold" Text="Bienvenido" />
                        <TextBlock Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}"
                                   FontSize="13" LineHeight="20" TextWrapping="Wrap"
                                   Text="{Binding LoginPrompt}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,22,0,0">
                        <TextBlock FontSize="10" FontWeight="Bold" Text="CORREO" />
                        <TextBox x:Name="EmailBox" Height="48" Margin="0,7,0,15" Padding="13,10"
                                 Background="White" BorderBrush="#C9D7DD" BorderThickness="1"
                                 Foreground="#172026" CaretBrush="#173B50" SelectionBrush="#B9DCEB"
                                 FontFamily="Segoe UI" FontSize="13" FontWeight="Normal"
                                 IsEnabled="{Binding NeedsCredentials}"
                                 AutomationProperties.Name="Correo de jefe de planta" />

                        <TextBlock FontSize="10" FontWeight="Bold" Text="CONTRASEÑA" />
                        <PasswordBox x:Name="PasswordBox" Height="48" Margin="0,7,0,12" Padding="13,10"
                                     Background="White" BorderBrush="#C9D7DD" BorderThickness="1"
                                     Foreground="#172026" CaretBrush="#173B50" SelectionBrush="#B9DCEB"
                                     FontFamily="Segoe UI" FontSize="13" FontWeight="Normal"
                                     PasswordChar="●" IsEnabled="{Binding NeedsCredentials}"
                                     AutomationProperties.Name="Contraseña" />

                        <Grid Margin="1,0,1,18">
                            <CheckBox x:Name="RememberEmailBox" VerticalAlignment="Center"
                                      Content="Recordar correo" IsEnabled="{Binding NeedsCredentials}"
                                      AutomationProperties.Name="Recordar correo reciente" />
                            <Button HorizontalAlignment="Right" Padding="0" MinHeight="0"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#2F7EA4" Click="OnRecover"
                                    Content="¿Olvidó su contraseña?" IsEnabled="{Binding NeedsCredentials}"
                                    AutomationProperties.Name="Recuperar contraseña" />
                        </Grid>

                        <Button Height="52" Background="{StaticResource NavyBrush}"
                                BorderBrush="{StaticResource NavyBrush}" Foreground="White"
                                FontWeight="Bold" Click="OnSignIn"
                                Content="{Binding LoginActionLabel}"
                                IsEnabled="{Binding CanInteract}"
                                AutomationProperties.Name="Abrir estación o sesión" />

                        <TextBlock Margin="3,13,3,0" HorizontalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"
                                   Foreground="{StaticResource MutedBrush}" FontSize="10"
                                   Text="{Binding Status}" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Margin="0,0,5,0" FontFamily="Segoe UI Emoji" FontSize="11" Text="🔒" />
                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10"
                                   Text="Sesión protegida y auditable" />
                    </StackPanel>
                </Grid>
    </Grid>
</UserControl>
