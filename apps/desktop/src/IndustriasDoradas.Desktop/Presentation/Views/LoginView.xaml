<UserControl x:Class="IndustriasDoradas.Desktop.Presentation.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Inicio de sesión de estación">
    <Grid Background="{StaticResource SoftCanvasBrush}">
        <Border Width="500" Padding="46,38" HorizontalAlignment="Center" VerticalAlignment="Center"
                Style="{StaticResource SurfaceCardStyle}" CornerRadius="22">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="15" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/logo-industrias-doradas.png"
                               Stretch="UniformToFill"
                               AutomationProperties.Name="Logo de Industrias Doradas" />
                    </Border>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Foreground="{StaticResource Ink900Brush}" FontSize="19"
                                   FontWeight="Bold" Text="INDUSTRIAS DORADAS" />
                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="Sistema de planta" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Margin="0,34,0,0" HorizontalAlignment="Center"
                           Foreground="#2F7EA4" FontSize="11" FontWeight="Bold"
                           Text="INICIO SEGURO" />
                <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center"
                           Foreground="{StaticResource Ink900Brush}" FontSize="30"
                           FontWeight="Bold" Text="Abrir estación" />
                <TextBlock Margin="20,10,20,25" Foreground="{StaticResource MutedBrush}"
                           FontSize="14" LineHeight="21" TextAlignment="Center" TextWrapping="Wrap"
                           Text="El jefe de planta inicia la sesión. Después, la estación permanece disponible para la operación diaria." />

                <TextBlock FontSize="11" FontWeight="Bold" Text="CORREO" />
                <TextBox x:Name="EmailBox" Height="48" Margin="0,7,0,17" Padding="13,10"
                         AutomationProperties.Name="Correo de jefe de planta" />
                <TextBlock FontSize="11" FontWeight="Bold" Text="CONTRASEÑA" />
                <PasswordBox x:Name="PasswordBox" Height="48" Margin="0,7,0,12" Padding="13,10"
                             AutomationProperties.Name="Contraseña" />
                <CheckBox x:Name="RememberEmailBox" Margin="1,0,0,18"
                          Content="Recordar este correo en el equipo"
                          AutomationProperties.Name="Recordar correo reciente" />

                <Button Height="50" Background="{StaticResource NavyBrush}"
                        BorderBrush="{StaticResource NavyBrush}" Foreground="White"
                        Click="OnSignIn" Content="ABRIR ESTACIÓN"
                        IsEnabled="{Binding CanInteract}"
                        AutomationProperties.Name="Abrir estación" />
                <Button Margin="0,8,0,0" Background="Transparent" BorderThickness="0"
                        Foreground="#2F7EA4" Click="OnRecover"
                        Content="Recuperar contraseña" IsEnabled="{Binding CanInteract}"
                        AutomationProperties.Name="Recuperar contraseña" />

                <Border Margin="0,18,0,0" Padding="13" Background="#F5F8F9" CornerRadius="10">
                    <TextBlock AutomationProperties.LiveSetting="Polite"
                               Foreground="{StaticResource Ink700Brush}"
                               Text="{Binding Status}" TextWrapping="Wrap" />
                </Border>
                <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" FontSize="11"
                           Text="Autenticación protegida · Supabase Auth mediante API" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
