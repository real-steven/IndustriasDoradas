<UserControl x:Class="IndustriasDoradas.Desktop.Presentation.Views.AttendancePreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Registro local de asistencia">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="AttendanceComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Foreground" Value="{StaticResource Ink900Brush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="OptionChrome" Margin="4,2" Padding="{TemplateBinding Padding}"
                                Background="Transparent" CornerRadius="7">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="OptionChrome" Property="Background" Value="#EAF3F7" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="OptionChrome" Property="Background" Value="#DDEEF5" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AttendanceComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C8D8DF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Ink900Brush}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource AttendanceComboBoxItemStyle}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="InputRoot">
                            <Border x:Name="InputChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <Grid>
                                    <ContentPresenter Margin="13,0,46,0"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      IsHitTestVisible="False" />
                                    <Border Width="38" Margin="0,5,5,5" HorizontalAlignment="Right"
                                            Background="#EDF4F7" CornerRadius="7">
                                        <Path Width="10" Height="6" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Data="M 0 0 L 5 5 L 10 0"
                                              Stroke="{StaticResource NavyBrush}" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Border>
                                </Grid>
                            </Border>
                            <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=InputRoot}" PopupAnimation="Fade">
                                <Border Width="{Binding ActualWidth, ElementName=InputRoot}" Margin="0,5,0,0"
                                        Padding="4" Background="White" BorderBrush="#C8D8DF"
                                        BorderThickness="1" CornerRadius="10">
                                    <ScrollViewer MaxHeight="260" CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputChrome" Property="BorderBrush" Value="#79A9BE" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputChrome" Property="BorderBrush" Value="#2F7EA4" />
                                <Setter TargetName="InputChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalContentAlignment="Stretch"
                  Background="{StaticResource SoftCanvasBrush}">
        <StackPanel Margin="34,26,34,42" MaxWidth="1380" HorizontalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Foreground="#2F7EA4" FontSize="11" FontWeight="Bold"
                               Text="CONTROL DE PERSONAL" />
                    <TextBlock Margin="0,7,0,0" FontSize="28" FontWeight="Bold"
                               Text="Asistencia" />
                    <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"
                               Text="Entrada y salida local-first, incluso cuando no haya Internet." />
                </StackPanel>
                <Button Grid.Column="1" MinWidth="128" VerticalAlignment="Center"
                        Command="{Binding RefreshCommand}" Content="↻  ACTUALIZAR" />
            </Grid>

            <Border Margin="0,18,0,0" Style="{StaticResource InfoAlertStyle}">
                <TextBlock AutomationProperties.LiveSetting="Polite" Text="{Binding Status}"
                           TextWrapping="Wrap" />
            </Border>

            <UniformGrid Margin="-6,18,-6,0" Columns="3">
                <Border Margin="6" Padding="18" Background="#EFFAF4" CornerRadius="14">
                    <StackPanel>
                        <TextBlock Foreground="#3D6B51" FontSize="11" FontWeight="Bold"
                                   Text="EN PLANTA" />
                        <TextBlock Margin="0,5,0,0" Foreground="#178449" FontSize="28"
                                   FontWeight="Bold" Text="{Binding PresentCount}" />
                    </StackPanel>
                </Border>
                <Border Margin="6" Padding="18" Background="#F2F7FA" CornerRadius="14">
                    <StackPanel>
                        <TextBlock Foreground="#526A78" FontSize="11" FontWeight="Bold"
                                   Text="JORNADAS ABIERTAS" />
                        <TextBlock Margin="0,5,0,0" FontSize="28" FontWeight="Bold"
                                   Text="{Binding OpenShiftCount}" />
                    </StackPanel>
                </Border>
                <Border Margin="6" Padding="18" Background="#FFF8E9" CornerRadius="14">
                    <StackPanel>
                        <TextBlock Foreground="#815D17" FontSize="11" FontWeight="Bold"
                                   Text="INCIDENCIAS" />
                        <TextBlock Margin="0,5,0,0" Foreground="#9A6500" FontSize="28"
                                   FontWeight="Bold" Text="{Binding IncidentCount}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="390" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="26" Style="{StaticResource SurfaceCardStyle}">
                    <StackPanel>
                        <TextBlock FontSize="21" FontWeight="Bold" Text="Registrar mi asistencia" />
                        <TextBlock Margin="0,6,0,18" Foreground="{StaticResource MutedBrush}"
                                   Text="Seleccione su nombre. El sistema habilitará únicamente la acción válida."
                                   TextWrapping="Wrap" />

                        <TextBlock Margin="0,0,0,7" FontSize="11" FontWeight="Bold"
                                   Text="TRABAJADOR" />
                        <ComboBox Style="{StaticResource AttendanceComboBoxStyle}"
                                  ItemsSource="{Binding Workers}"
                                  SelectedItem="{Binding SelectedWorker}"
                                  DisplayMemberPath="DisplayName"
                                  AutomationProperties.Name="Seleccionar trabajador" />

                        <Border Margin="0,14,0,0" Padding="15" Background="#F3F7F9"
                                BorderBrush="#CADCE4" BorderThickness="1" CornerRadius="12">
                            <TextBlock FontWeight="SemiBold" Text="{Binding SelectedWorkerSummary}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" MinHeight="62" Background="#EAF8F0"
                                    BorderBrush="#AAD8BC" Foreground="#147A42"
                                    Command="{Binding CheckInCommand}"
                                    Content="→  REGISTRAR ENTRADA" />
                            <Button Grid.Column="2" MinHeight="62" Background="#F5F8FA"
                                    BorderBrush="#BED0D9" Foreground="#244A5C"
                                    Command="{Binding CheckOutCommand}"
                                    Content="←  REGISTRAR SALIDA" />
                            <Grid Grid.Column="4">
                                <Button x:Name="CorrectionButton" MinWidth="132" MinHeight="62"
                                        Background="#FFF8E9" BorderBrush="#E1BD72" Foreground="#815D17"
                                        Command="{Binding ToggleCorrectionPanelCommand}"
                                        Content="⚙  CORREGIR SALIDA"
                                        AutomationProperties.Name="Corregir salida olvidada"
                                        ToolTip="Corregir una salida olvidada con Modo Jefe de Planta" />
                                <Popup IsOpen="{Binding IsCorrectionPanelOpen, Mode=TwoWay}"
                                       Placement="Bottom" PlacementTarget="{Binding ElementName=CorrectionButton}"
                                       HorizontalOffset="-330" VerticalOffset="7"
                                       AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                                    <Border Width="440" Padding="20" Background="White"
                                            BorderBrush="#C8D8DF" BorderThickness="1" CornerRadius="14">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontSize="18" FontWeight="Bold"
                                                               Text="Corregir salida olvidada" />
                                                    <TextBlock Margin="0,4,20,0" Foreground="{StaticResource MutedBrush}"
                                                               Text="Disponible únicamente con Modo Jefe de Planta. La corrección quedará auditada."
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Width="34" Height="34" Padding="0"
                                                        Command="{Binding CloseCorrectionPanelCommand}"
                                                        Content="×" ToolTip="Cerrar" />
                                            </Grid>
                                            <Grid Margin="0,16,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontSize="11" FontWeight="Bold" Text="FECHA REAL DE SALIDA" />
                                                    <DatePicker MinHeight="42" Margin="0,7,0,0" Padding="8,4"
                                                                SelectedDate="{Binding CorrectionDate, UpdateSourceTrigger=PropertyChanged}"
                                                                AutomationProperties.Name="Fecha real de salida" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock FontSize="11" FontWeight="Bold" Text="HORA (24 H)" />
                                                    <TextBox MinHeight="42" Margin="0,7,0,0" Padding="10"
                                                             VerticalContentAlignment="Center" MaxLength="5"
                                                             Text="{Binding CorrectionTime, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="Hora real de salida" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock FontSize="11" FontWeight="Bold" Text="MOTIVO OBLIGATORIO" />
                                            <TextBox MinHeight="64" Margin="0,7,0,10" Padding="10"
                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                     Text="{Binding CorrectionReason, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Margin="0,0,0,10" Foreground="{StaticResource MutedBrush}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Text="{Binding CorrectionValidationMessage}" />
                                            <Button MinHeight="46" Command="{Binding CorrectOpenShiftCommand}"
                                                    Content="CERRAR JORNADA CON CORRECCIÓN" />
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>

                        <TextBlock Margin="0,15,0,0" Foreground="{StaticResource MutedBrush}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Text="La marca se guarda primero en este equipo. Una pulsación repetida queda bloqueada mientras se procesa." />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Width="390" Height="610" Padding="22" VerticalAlignment="Top"
                        Style="{StaticResource SurfaceCardStyle}" CornerRadius="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="390" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontSize="19" FontWeight="Bold" Text="Estado del personal" />
                        <TextBlock Grid.Row="1" Margin="0,5,0,10" Foreground="{StaticResource MutedBrush}"
                                   Text="Resumen local de cada trabajador." />
                        <TextBlock Grid.Row="2" Margin="0,0,0,5" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}" Text="BUSCAR PERSONAL" />
                        <TextBox Grid.Row="3" MinHeight="38" Margin="0,0,0,12" Padding="11,7"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding WorkerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Buscar personal"
                                 ToolTip="Buscar por nombre, rol o estado" />
                        <ItemsControl Grid.Row="4" Height="390" ItemsSource="{Binding VisibleWorkers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="70" Margin="0,0,0,8" Padding="13,9"
                                                Background="#F7F9FA"
                                                BorderBrush="#DCE6EA" BorderThickness="1" CornerRadius="11">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontWeight="Bold" Text="{Binding DisplayName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding DisplayName}" />
                                                    <TextBlock Margin="0,2,0,0" Foreground="#2F7EA4"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Text="{Binding CategoryLabel}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}"
                                                               FontSize="11" Text="{Binding LastMark}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding LastMark}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding StateColor}"
                                                           FontWeight="Bold" Text="{Binding State}"
                                                           TextWrapping="NoWrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Grid.Row="5" Margin="0,3,0,0" VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button MinWidth="38" MinHeight="32" Padding="8,3"
                                    Command="{Binding PreviousWorkerPageCommand}"
                                    Content="‹" ToolTip="Página anterior" />
                            <TextBlock Grid.Column="1" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                       FontSize="11" Text="{Binding WorkerPageDescription}" />
                            <Button Grid.Column="2" MinWidth="38" MinHeight="32" Padding="8,3"
                                    Command="{Binding NextWorkerPageCommand}"
                                    Content="›" ToolTip="Página siguiente" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
