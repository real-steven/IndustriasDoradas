<UserControl x:Class="IndustriasDoradas.Desktop.Presentation.Views.AttendancePreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Vista conceptual de asistencia">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource SoftCanvasBrush}">
        <StackPanel Margin="34,26,34,42" MaxWidth="1380" HorizontalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Foreground="#2F7EA4" FontSize="11" FontWeight="Bold"
                               Text="CONTROL DE PERSONAL" />
                    <TextBlock Margin="0,7,0,0" FontSize="28" FontWeight="Bold"
                               Text="Asistencia" />
                    <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"
                               Text="Ejemplo visual del futuro registro de entrada, salida y horas trabajadas." />
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Center" Padding="13,8"
                        Background="#FFF5D7" BorderBrush="#E6C665" BorderThickness="1"
                        CornerRadius="14">
                    <TextBlock Foreground="#815D17" FontSize="11" FontWeight="Bold"
                               Text="●  PRÓXIMAMENTE" />
                </Border>
            </Grid>

            <Border Margin="0,18,0,0" Style="{StaticResource WarningAlertStyle}">
                <TextBlock AutomationProperties.LiveSetting="Polite" Text="{Binding Status}"
                           TextWrapping="Wrap" />
            </Border>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="5*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="26" Style="{StaticResource SurfaceCardStyle}">
                    <StackPanel>
                        <TextBlock FontSize="21" FontWeight="Bold" Text="Registrar asistencia" />
                        <TextBlock Margin="0,6,0,18" Foreground="{StaticResource MutedBrush}"
                                   Text="El trabajador se identificará y elegirá si está entrando o saliendo."
                                   TextWrapping="Wrap" />

                        <Border MinHeight="190" Padding="22" Background="#F3F7F9"
                                BorderBrush="#CADCE4" BorderThickness="1" CornerRadius="16">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" FontFamily="Segoe UI Emoji"
                                           FontSize="48" Text="📷" />
                                <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center"
                                           FontSize="17" FontWeight="Bold"
                                           Text="Esperando identificación" />
                                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}" TextAlignment="Center"
                                           Text="Cámara, dispositivo local o selección manual futura"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" MinHeight="58"
                                    Command="{Binding ShowComingSoonCommand}"
                                    CommandParameter="registro de entrada"
                                    Content="→  REGISTRAR ENTRADA" />
                            <Button Grid.Column="2" MinHeight="58"
                                    Command="{Binding ShowComingSoonCommand}"
                                    CommandParameter="registro de salida"
                                    Content="←  REGISTRAR SALIDA" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Padding="22" Style="{StaticResource SurfaceCardStyle}" CornerRadius="16">
                        <StackPanel>
                            <TextBlock FontSize="19" FontWeight="Bold" Text="Personal hoy" />
                            <TextBlock Margin="0,5,0,15" Foreground="{StaticResource MutedBrush}"
                                       Text="Resumen que podrá consultar el jefe de planta."
                                       TextWrapping="Wrap" />
                            <Border Padding="14" Background="#F3F8F5" CornerRadius="11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="Bold" Text="Actualmente en planta" />
                                    <TextBlock Grid.Column="1" Foreground="#207946" FontSize="20"
                                               FontWeight="Bold" Text="—" />
                                </Grid>
                            </Border>
                            <Border Margin="0,9,0,0" Padding="14" Background="#F7F9FA" CornerRadius="11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="Bold" Text="Marcas abiertas" />
                                    <TextBlock Grid.Column="1" FontSize="20" FontWeight="Bold" Text="—" />
                                </Grid>
                            </Border>
                            <Border Margin="0,9,0,0" Padding="14" Background="#FFF8E9" CornerRadius="11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="Bold" Text="Incidencias" />
                                    <TextBlock Grid.Column="1" Foreground="#8A5A00" FontSize="20"
                                               FontWeight="Bold" Text="—" />
                                </Grid>
                            </Border>
                            <TextBlock Margin="0,14,0,0" Foreground="{StaticResource MutedBrush}"
                                       FontSize="10"
                                       Text="Los valores reales aparecerán cuando se implemente el Sprint 6."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0" Padding="22" Style="{StaticResource SurfaceCardStyle}"
                            CornerRadius="16">
                        <StackPanel>
                            <TextBlock FontSize="19" FontWeight="Bold" Text="Identificación futura" />
                            <TextBlock Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}"
                                       Text="La primera versión conservará una alternativa manual. Una cámara USB o un punto Raspberry podrán integrarse después sin bloquear la asistencia."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Margin="0,18,0,0" Padding="22" Style="{StaticResource SurfaceCardStyle}">
                <StackPanel>
                    <TextBlock FontSize="19" FontWeight="Bold" Text="Flujo previsto" />
                    <UniformGrid Margin="-5,12,-5,0" Columns="4">
                        <Border Margin="5" Padding="14" Background="#F7F9FA" CornerRadius="11">
                            <StackPanel><TextBlock FontWeight="Bold" Text="1 · Identificar" /><TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" Text="Cámara o selección manual." TextWrapping="Wrap" /></StackPanel>
                        </Border>
                        <Border Margin="5" Padding="14" Background="#F7F9FA" CornerRadius="11">
                            <StackPanel><TextBlock FontWeight="Bold" Text="2 · Elegir" /><TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" Text="Entrada o salida explícita." TextWrapping="Wrap" /></StackPanel>
                        </Border>
                        <Border Margin="5" Padding="14" Background="#F7F9FA" CornerRadius="11">
                            <StackPanel><TextBlock FontWeight="Bold" Text="3 · Guardar" /><TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" Text="Registro local aunque no haya Internet." TextWrapping="Wrap" /></StackPanel>
                        </Border>
                        <Border Margin="5" Padding="14" Background="#F7F9FA" CornerRadius="11">
                            <StackPanel><TextBlock FontWeight="Bold" Text="4 · Consultar" /><TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" Text="Horas e incidencias auditables." TextWrapping="Wrap" /></StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
