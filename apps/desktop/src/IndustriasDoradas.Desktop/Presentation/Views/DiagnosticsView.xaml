<UserControl x:Class="IndustriasDoradas.Desktop.Presentation.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:domain="clr-namespace:IndustriasDoradas.Desktop.Domain"
             xmlns:abstractions="clr-namespace:IndustriasDoradas.Desktop.Application.Abstractions"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="520"
             d:DesignWidth="760">
    <UserControl.Resources>
        <Style x:Key="HealthCardStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static domain:HealthState.Available}">
                    <Setter Property="BorderBrush" Value="#A6D6BF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static domain:HealthState.Unavailable}">
                    <Setter Property="BorderBrush" Value="#F5B7B1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HealthDotStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{StaticResource Gold500Brush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static domain:HealthState.Available}">
                    <Setter Property="Fill" Value="#18794E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static domain:HealthState.Unavailable}">
                    <Setter Property="Fill" Value="#B42318" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="56" MaxWidth="760">
            <TextBlock Foreground="#8A5B0A"
                       FontSize="12"
                       FontWeight="Bold"
                       Text="DIAGNÓSTICO" />
            <TextBlock Margin="0,12,0,0"
                       Foreground="{StaticResource Ink900Brush}"
                       FontSize="42"
                       FontWeight="Bold"
                       Text="Estado del sistema" />
            <TextBlock Margin="0,12,0,28"
                       Foreground="{StaticResource Ink700Brush}"
                       FontSize="16"
                       Text="Salud del guardado local y comunicación con la API." />

            <Border Margin="0,0,0,20"
                    Padding="28"
                    BorderThickness="1"
                    CornerRadius="14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LocalState}"
                                         Value="{x:Static abstractions:LocalDatabaseHealthState.Healthy}">
                                <Setter Property="BorderBrush" Value="#A6D6BF" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LocalState}"
                                         Value="{x:Static abstractions:LocalDatabaseHealthState.Attention}">
                                <Setter Property="BorderBrush" Value="#E1C16E" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LocalState}"
                                         Value="{x:Static abstractions:LocalDatabaseHealthState.Unavailable}">
                                <Setter Property="BorderBrush" Value="#F5B7B1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Foreground="#8A5B0A"
                               FontSize="12"
                               FontWeight="Bold"
                               Text="ALMACENAMIENTO LOCAL" />
                    <TextBlock Margin="0,7,0,0"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{StaticResource Ink900Brush}"
                               FontSize="24"
                               FontWeight="Bold"
                               Text="{Binding LocalStatusTitle}" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{StaticResource Ink700Brush}"
                               FontSize="15"
                               Text="{Binding LocalStatusMessage}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#8A5B0A"
                               FontSize="14"
                               Text="{Binding LocalRecoveryInstruction}"
                               TextWrapping="Wrap" />
                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource Ink700Brush}" FontSize="12" Text="Pendientes" />
                            <TextBlock Margin="0,4,0,0" FontWeight="Bold" Text="{Binding PendingOperations}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Foreground="{StaticResource Ink700Brush}" FontSize="12" Text="Espacio" />
                            <TextBlock Margin="0,4,0,0" FontWeight="Bold" Text="{Binding AvailableSpace}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Foreground="{StaticResource Ink700Brush}" FontSize="12" Text="Comprobado" />
                            <TextBlock Margin="0,4,0,0" FontWeight="Bold" Text="{Binding LocalLastChecked}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,24,0,0" Orientation="Horizontal">
                        <Button Command="{Binding CreateRecoveryCopyCommand}"
                                Content="Crear copia de recuperación"
                                AutomationProperties.Name="Crear copia consistente de recuperación" />
                        <TextBlock Margin="16,0,0,0"
                                   MaxWidth="440"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Ink700Brush}"
                                   Text="{Binding RecoveryCopyStatus}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="28"
                    BorderThickness="1"
                    CornerRadius="14"
                    Style="{StaticResource HealthCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0"
                             Width="14"
                             Height="14"
                             Margin="0,7,16,0"
                             VerticalAlignment="Top"
                             Style="{StaticResource HealthDotStyle}" />

                    <StackPanel Grid.Column="1">
                        <TextBlock AutomationProperties.LiveSetting="Polite"
                                   Foreground="{StaticResource Ink900Brush}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Text="{Binding StatusTitle}" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource Ink700Brush}"
                                   FontSize="15"
                                   Text="{Binding StatusMessage}"
                                   TextWrapping="Wrap" />

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Foreground="{StaticResource Ink700Brush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="Servicio" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{StaticResource Ink900Brush}"
                                           FontWeight="Bold"
                                           Text="{Binding Service}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Foreground="{StaticResource Ink700Brush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="Última respuesta" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{StaticResource Ink900Brush}"
                                           FontWeight="Bold"
                                           Text="{Binding LastChecked}" />
                            </StackPanel>
                        </Grid>

                        <Button Margin="0,26,0,0"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Actualizar estado de la API"
                                Background="{StaticResource Ink900Brush}"
                                BorderBrush="{StaticResource Ink900Brush}"
                                Command="{Binding RefreshCommand}"
                                Content="Actualizar estado"
                                Foreground="White" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
