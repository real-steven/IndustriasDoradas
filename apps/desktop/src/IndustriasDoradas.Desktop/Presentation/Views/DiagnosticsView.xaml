<UserControl x:Class="IndustriasDoradas.Desktop.Presentation.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:domain="clr-namespace:IndustriasDoradas.Desktop.Domain"
             xmlns:abstractions="clr-namespace:IndustriasDoradas.Desktop.Application.Abstractions"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="520"
             d:DesignWidth="760">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="HealthCardStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static domain:HealthState.Available}">
                    <Setter Property="BorderBrush" Value="#A6D6BF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static domain:HealthState.Unavailable}">
                    <Setter Property="BorderBrush" Value="#F5B7B1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HealthDotStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{StaticResource Gold500Brush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static domain:HealthState.Available}">
                    <Setter Property="Fill" Value="#18794E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static domain:HealthState.Unavailable}">
                    <Setter Property="Fill" Value="#B42318" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="56" MaxWidth="760">
            <TextBlock Foreground="#8A5B0A"
                       FontSize="12"
                       FontWeight="Bold"
                       Text="DIAGNÓSTICO" />
            <TextBlock Margin="0,12,0,0"
                       Foreground="{StaticResource Ink900Brush}"
                       FontSize="42"
                       FontWeight="Bold"
                       Text="Estado del sistema" />
            <TextBlock Margin="0,12,0,28"
                       Foreground="{StaticResource Ink700Brush}"
                       FontSize="16"
                       Text="Salud del guardado local y comunicación con la API." />

            <Border Margin="0,0,0,20"
                    Padding="28"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel>
                    <TextBlock Foreground="#8A5B0A" FontSize="12" FontWeight="Bold"
                               Text="SINCRONIZACIÓN DE LA ESTACIÓN" />
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource Ink700Brush}" FontSize="12" Text="Estación" />
                            <TextBlock Margin="0,4,12,0" FontWeight="Bold" Text="{Binding Station}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Foreground="{StaticResource Ink700Brush}" FontSize="12" Text="Versión" />
                            <TextBlock Margin="0,4,0,0" FontWeight="Bold" Text="{Binding ApplicationVersion}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Foreground="{StaticResource Ink700Brush}" FontSize="12" Text="Red" />
                            <TextBlock Margin="0,4,0,0" FontWeight="Bold" Text="{Binding NetworkStatus}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource Ink700Brush}" FontSize="12" Text="Última sincronización" />
                            <TextBlock Margin="0,4,0,0" FontWeight="Bold" Text="{Binding LastSynchronization}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Foreground="{StaticResource Ink700Brush}" FontSize="12" Text="Desviación del reloj" />
                            <TextBlock Margin="0,4,0,0" FontWeight="Bold" Text="{Binding ClockDeviation}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,20"
                    Padding="28"
                    BorderThickness="1"
                    CornerRadius="14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LocalState}"
                                         Value="{x:Static abstractions:LocalDatabaseHealthState.Healthy}">
                                <Setter Property="BorderBrush" Value="#A6D6BF" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LocalState}"
                                         Value="{x:Static abstractions:LocalDatabaseHealthState.Attention}">
                                <Setter Property="BorderBrush" Value="#E1C16E" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LocalState}"
                                         Value="{x:Static abstractions:LocalDatabaseHealthState.Unavailable}">
                                <Setter Property="BorderBrush" Value="#F5B7B1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Foreground="#8A5B0A"
                               FontSize="12"
                               FontWeight="Bold"
                               Text="ALMACENAMIENTO LOCAL" />
                    <TextBlock Margin="0,7,0,0"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{StaticResource Ink900Brush}"
                               FontSize="24"
                               FontWeight="Bold"
                               Text="{Binding LocalStatusTitle}" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{StaticResource Ink700Brush}"
                               FontSize="15"
                               Text="{Binding LocalStatusMessage}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#8A5B0A"
                               FontSize="14"
                               Text="{Binding LocalRecoveryInstruction}"
                               TextWrapping="Wrap" />
                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource Ink700Brush}" FontSize="12" Text="Pendientes" />
                            <TextBlock Margin="0,4,0,0" FontWeight="Bold" Text="{Binding PendingOperations}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Foreground="{StaticResource Ink700Brush}" FontSize="12" Text="Espacio" />
                            <TextBlock Margin="0,4,0,0" FontWeight="Bold" Text="{Binding AvailableSpace}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Foreground="{StaticResource Ink700Brush}" FontSize="12" Text="Comprobado" />
                            <TextBlock Margin="0,4,0,0" FontWeight="Bold" Text="{Binding LocalLastChecked}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,24,0,0" Orientation="Horizontal">
                        <Button Command="{Binding CreateRecoveryCopyCommand}"
                                Content="Crear copia de recuperación"
                                AutomationProperties.Name="Crear copia consistente de recuperación" />
                        <TextBlock Margin="16,0,0,0"
                                   MaxWidth="440"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Ink700Brush}"
                                   Text="{Binding RecoveryCopyStatus}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,20"
                    Padding="28"
                    BorderThickness="1"
                    CornerRadius="14"
                    Style="{StaticResource HealthCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0"
                             Width="14"
                             Height="14"
                             Margin="0,7,16,0"
                             VerticalAlignment="Top"
                             Style="{StaticResource HealthDotStyle}" />

                    <StackPanel Grid.Column="1">
                        <TextBlock AutomationProperties.LiveSetting="Polite"
                                   Foreground="{StaticResource Ink900Brush}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Text="{Binding StatusTitle}" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource Ink700Brush}"
                                   FontSize="15"
                                   Text="{Binding StatusMessage}"
                                   TextWrapping="Wrap" />

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Foreground="{StaticResource Ink700Brush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="Servicio" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{StaticResource Ink900Brush}"
                                           FontWeight="Bold"
                                           Text="{Binding Service}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Foreground="{StaticResource Ink700Brush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="Última respuesta" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{StaticResource Ink900Brush}"
                                           FontWeight="Bold"
                                           Text="{Binding LastChecked}" />
                            </StackPanel>
                        </Grid>

                        <Button Margin="0,26,0,0"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Actualizar estado de la API"
                                Background="{StaticResource Ink900Brush}"
                                BorderBrush="{StaticResource Ink900Brush}"
                                Command="{Binding RefreshCommand}"
                                Content="Actualizar estado"
                                Foreground="White" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Margin="0,0,0,20"
                    Padding="28"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel>
                    <TextBlock Foreground="#8A5B0A" FontSize="12" FontWeight="Bold"
                               Text="EVENTOS QUE REQUIEREN REVISIÓN" />
                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Ink700Brush}"
                               Text="La causa se muestra con un código estable. La resolución corresponde al soporte o al administrador; desde aquí no se modifica el evento." TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Ink700Brush}"
                               Text="{Binding PullReviewCount, StringFormat=Revisiones de cambios recibidos: {0}}" />
                    <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Failures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="14" Background="#FFF8E8" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold" Text="{Binding ErrorCode}" />
                                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Ink700Brush}">
                                            <Run Text="{Binding OperationType}" /><Run Text=" · intentos: " /><Run Text="{Binding AttemptCount}" />
                                        </TextBlock>
                                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Ink700Brush}"
                                                   Text="{Binding Cause}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,3,0,0" Foreground="{StaticResource Ink700Brush}"
                                                   Text="{Binding LastAttemptAt, StringFormat=Último intento: {0:g}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,20"
                    Padding="28"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="#E1C16E"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel>
                    <TextBlock Foreground="#8A5B0A" FontSize="12" FontWeight="Bold"
                               Text="AUDITORÍA DE CORRECCIONES RECIBIDAS" />
                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Ink700Brush}"
                               Text="Las correcciones centrales conservan administrador, motivo y cambios; nunca reemplazan el registro original." TextWrapping="Wrap" />
                    <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Corrections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="14" Background="#F5F7F8" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold">
                                            <Run Text="{Binding Administrator}" /><Run Text=" · " /><Run Text="{Binding RoleCode}" />
                                        </TextBlock>
                                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Ink700Brush}">
                                            <Run Text="Motivo: " /><Run Text="{Binding Reason}" /><Run Text=" · " /><Run Text="{Binding OccurredAt, StringFormat={}{0:g}}" />
                                        </TextBlock>
                                        <ItemsControl Margin="0,7,0,0" ItemsSource="{Binding Changes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="8,2,0,0" Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Padding="28"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel>
                    <TextBlock Foreground="#8A5B0A" FontSize="12" FontWeight="Bold"
                               Text="REPORTE PARA SOPORTE" />
                    <TextBlock Margin="0,8,0,16" Foreground="{StaticResource Ink700Brush}"
                               Text="Exporta conteos, códigos y horarios. El archivo no incluye tokens, PIN ni payloads de operación." TextWrapping="Wrap" />
                    <Button HorizontalAlignment="Left" Command="{Binding ExportDiagnosticReportCommand}"
                            Content="Exportar diagnóstico seguro" />
                    <TextBlock Margin="0,10,0,0" Foreground="{StaticResource Ink700Brush}"
                               Text="{Binding DiagnosticReportStatus}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
