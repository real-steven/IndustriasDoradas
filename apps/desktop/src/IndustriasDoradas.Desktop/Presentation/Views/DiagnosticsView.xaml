<UserControl x:Class="IndustriasDoradas.Desktop.Presentation.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Diagnóstico local">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource SoftCanvasBrush}">
        <StackPanel Margin="34,26,34,42" MaxWidth="1380" HorizontalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Foreground="#2F7EA4" FontSize="11" FontWeight="Bold" Text="ESTADO DEL SISTEMA" />
                    <TextBlock Margin="0,7,0,0" FontSize="28" FontWeight="Bold" Text="Diagnóstico" />
                    <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"
                               Text="Compruebe la conexión y el guardado de datos de esta estación." />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding RefreshCommand}"
                        Content="↻  REINTENTAR SINCRONIZACIÓN" />
            </Grid>

            <UniformGrid Margin="0,18,0,0" Columns="4">
                <Border Margin="0,0,6,0" Padding="19" Style="{StaticResource SurfaceCardStyle}"
                        CornerRadius="16">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe UI Emoji" FontSize="27" Text="☁" />
                        <TextBlock Margin="0,12,0,0" FontSize="17" FontWeight="Bold" Text="Conexión con el sistema" />
                        <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"
                                   Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,13,0,0" Foreground="#2F7EA4" FontWeight="Bold"
                                   Text="{Binding StatusTitle}" />
                    </StackPanel>
                </Border>
                <Border Margin="6,0" Padding="19" Style="{StaticResource SurfaceCardStyle}"
                        CornerRadius="16">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe UI Emoji" FontSize="27" Text="↻" />
                        <TextBlock Margin="0,12,0,0" FontSize="17" FontWeight="Bold" Text="Sincronización de datos" />
                        <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"
                                   Text="{Binding LastSynchronization, StringFormat=Última: {0}}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,13,0,0" Foreground="#2F7EA4" FontWeight="Bold"
                                   Text="{Binding PendingOperations}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Margin="6,0" Padding="19" Style="{StaticResource SurfaceCardStyle}"
                        CornerRadius="16">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe UI Emoji" FontSize="27" Text="▣" />
                        <TextBlock Margin="0,12,0,0" FontSize="17" FontWeight="Bold" Text="Datos en este equipo" />
                        <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"
                                   Text="{Binding LocalStatusMessage}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,13,0,0" Foreground="#2F7EA4" FontWeight="Bold"
                                   Text="{Binding LocalStatusTitle}" />
                    </StackPanel>
                </Border>
                <Border Margin="6,0,0,0" Padding="19" Style="{StaticResource SurfaceCardStyle}"
                        CornerRadius="16">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe UI Emoji" FontSize="27" Text="⌁" />
                        <TextBlock Margin="0,12,0,0" FontSize="17" FontWeight="Bold" Text="{Binding StationName}" />
                        <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" FontSize="10"
                                   Text="{Binding StationCode, StringFormat=Código de estación: {0}}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding StationCode}" />
                        <TextBlock Margin="0,13,0,0" Foreground="#2F7EA4" FontWeight="Bold"
                                   Text="{Binding ApplicationVersion, StringFormat=Versión {0}}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Margin="0,18,0,0" Padding="23" Style="{StaticResource SurfaceCardStyle}">
                <StackPanel>
                    <TextBlock FontSize="19" FontWeight="Bold" Text="Estado del equipo y soporte" />
                    <Grid Margin="0,17,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="CONEXIÓN" /><TextBlock Margin="0,5,12,0" FontWeight="Bold" Text="{Binding NetworkStatus}" TextWrapping="Wrap" /></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Foreground="{StaticResource MutedBrush}" Text="RELOJ" /><TextBlock Margin="0,5,12,0" FontWeight="Bold" Text="{Binding ClockDeviation}" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Foreground="{StaticResource MutedBrush}" Text="ESPACIO EN EL EQUIPO" /><TextBlock Margin="0,5,12,0" FontWeight="Bold" Text="{Binding AvailableSpace}" /></StackPanel>
                        <StackPanel Grid.Column="3"><TextBlock Foreground="{StaticResource MutedBrush}" Text="COMPROBADO" /><TextBlock Margin="0,5,0,0" FontWeight="Bold" Text="{Binding LocalLastChecked}" /></StackPanel>
                    </Grid>
                    <TextBlock Margin="0,17,0,0" Foreground="#8A5A00"
                               Text="{Binding LocalRecoveryInstruction}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,14,0,0" Foreground="{StaticResource MutedBrush}"
                               Text="Las acciones siguientes generan archivos locales y requieren Modo Jefe de Planta." />
                    <TextBlock Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="El respaldo conserva una copia completa de los datos de esta estación. El informe para soporte reúne el estado de conexión y los errores técnicos sin incluir contraseñas." />
                    <WrapPanel Margin="0,16,0,0">
                        <Button Command="{Binding CreateRecoveryCopyCommand}" Content="🔒  CREAR RESPALDO DE LA ESTACIÓN" />
                        <Button Margin="8,0,0,0" Command="{Binding ExportDiagnosticReportCommand}"
                                Content="🔒  GENERAR INFORME PARA SOPORTE" />
                        <Button Margin="8,0,0,0" Command="{Binding OpenSupportFolderCommand}"
                                Content="📁  ABRIR CARPETA DE SOPORTE"
                                ToolTip="{Binding SupportFolderPath}" />
                    </WrapPanel>
                    <TextBlock Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}"
                               Text="{Binding RecoveryCopyStatus}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"
                               Text="{Binding DiagnosticReportStatus}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"
                               Text="{Binding SupportFolderStatus}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
