<UserControl x:Class="IndustriasDoradas.Desktop.Presentation.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="520"
             d:DesignWidth="760">
    <Grid Margin="56">
        <StackPanel MaxWidth="700"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
            <TextBlock Foreground="#8A5B0A"
                       FontSize="12"
                       FontWeight="Bold"
                       Text="ESCRITORIO" />
            <TextBlock Margin="0,12,0,0"
                       Foreground="{StaticResource Ink900Brush}"
                       FontSize="48"
                       FontWeight="Bold"
                       Text="{Binding Title}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,18,0,0"
                       Foreground="{StaticResource Ink700Brush}"
                       FontSize="17"
                       LineHeight="27"
                       MaxWidth="620"
                       Text="{Binding Message}"
                       TextWrapping="Wrap" />
            <Border Margin="0,34,0,0"
                    Padding="20"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Background="{StaticResource SurfaceBrush}">
                <TextBlock Foreground="{StaticResource Ink700Brush}"
                           Text="Usa la navegación lateral para revisar la comunicación con la API."
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
