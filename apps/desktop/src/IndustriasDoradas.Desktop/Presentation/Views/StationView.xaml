<UserControl x:Class="IndustriasDoradas.Desktop.Presentation.Views.StationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Control de estación">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="48" MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock FontSize="36" FontWeight="Bold" Text="Estación de planta" />
            <TextBlock Margin="0,8,0,24" Text="{Binding Status}" TextWrapping="Wrap" />
            <GroupBox Header="Abrir estación con Supabase Auth" Padding="16">
                <StackPanel>
                    <Label Target="{Binding ElementName=EmailBox}" Content="Correo" />
                    <TextBox x:Name="EmailBox" AutomationProperties.Name="Correo de jefe de planta" />
                    <Label Margin="0,10,0,0" Target="{Binding ElementName=PasswordBox}" Content="Contraseña" />
                    <PasswordBox x:Name="PasswordBox" AutomationProperties.Name="Contraseña" />
                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                        <Button Click="OnSignIn" Content="Abrir estación" AutomationProperties.Name="Abrir estación" />
                        <Button Margin="10,0,0,0" Click="OnRecover" Content="Recuperar contraseña" AutomationProperties.Name="Recuperar contraseña" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <GroupBox Margin="0,20,0,0" Header="Elevación temporal" Padding="16">
                <StackPanel>
                    <Label Target="{Binding ElementName=PinBox}" Content="PIN individual" />
                    <PasswordBox x:Name="PinBox" MaxLength="12" AutomationProperties.Name="PIN individual" />
                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                        <Button Click="OnElevate" Content="Entrar a Modo Jefe de Planta" AutomationProperties.Name="Elevar permisos" />
                        <Button Margin="10,0,0,0" Command="{Binding ExitManagerModeCommand}" Content="Volver a Modo Operación" AutomationProperties.Name="Salir de modo jefe" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <GroupBox Margin="0,20,0,0"
                      Header="Preparar Línea 1"
                      Padding="16"
                      Visibility="{Binding IsPlantManager, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding PilotLineName}" />
                    <TextBlock Margin="0,4,0,14" Foreground="#667085" Text="{Binding WorkPeriodDescription}" />

                    <Label Target="{Binding ElementName=SupplierBox}" Content="Proveedor *" />
                    <ComboBox x:Name="SupplierBox"
                              MinWidth="360"
                              AutomationProperties.Name="Proveedor del cargamento"
                              DisplayMemberPath="Name"
                              ItemsSource="{Binding Suppliers}"
                              SelectedItem="{Binding SelectedSupplier}" />

                    <TextBlock Margin="0,12,0,0" FontWeight="Bold" Text="Cargamento" />
                    <TextBlock Margin="0,3,0,12"
                               Foreground="#667085"
                               Text="Nuevo · inicio automático al confirmar" />

                    <Label Target="{Binding ElementName=WorkerBox}" Content="Responsable principal *" />
                    <ComboBox x:Name="WorkerBox"
                              MinWidth="360"
                              AutomationProperties.Name="Responsable principal"
                              DisplayMemberPath="Name"
                              ItemsSource="{Binding Workers}"
                              SelectedItem="{Binding SelectedWorker}" />

                    <Border Margin="0,16,0,0"
                            Padding="12"
                            Background="#FFF8E7"
                            BorderBrush="#E1C16E"
                            BorderThickness="1"
                            CornerRadius="8">
                        <TextBlock AutomationProperties.LiveSetting="Polite"
                                   Text="{Binding PreparationSummary}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                        <Button Command="{Binding PrepareLineCommand}"
                                Content="Preparar resumen"
                                AutomationProperties.Name="Preparar resumen del cargamento" />
                        <Button Margin="10,0,0,0"
                                Command="{Binding ConfirmLineCommand}"
                                Content="Confirmar y dejar lista"
                                AutomationProperties.Name="Confirmar cargamento y dejar línea lista" />
                        <Button Margin="10,0,0,0"
                                Command="{Binding CancelPreparationCommand}"
                                Content="Cancelar"
                                AutomationProperties.Name="Cancelar preparación" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <TextBox Margin="0,20,0,0"
                     MinHeight="70"
                     AcceptsReturn="True"
                     Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding IsPlantManager, Converter={StaticResource BooleanToVisibilityConverter}}"
                     AutomationProperties.Name="Notas del borrador operativo" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
