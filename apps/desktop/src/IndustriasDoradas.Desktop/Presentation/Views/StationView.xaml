<UserControl x:Class="IndustriasDoradas.Desktop.Presentation.Views.StationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             AutomationProperties.Name="Control de estación">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Ink700Brush}" />
        </Style>
        <Style x:Key="StationComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Foreground" Value="{StaticResource Ink900Brush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="OptionChrome" Margin="4,2" Padding="{TemplateBinding Padding}"
                                Background="Transparent" CornerRadius="7">
                            <TextBlock Text="{Binding Content.Name, RelativeSource={RelativeSource TemplatedParent}}"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="OptionChrome" Property="Background" Value="#EAF3F7" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="OptionChrome" Property="Background" Value="#DDEEF5" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#748792" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StationComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C8D8DF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Ink900Brush}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource StationComboBoxItemStyle}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="InputRoot">
                            <Border x:Name="InputChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <Grid>
                                    <TextBlock x:Name="SelectionText" Margin="13,0,46,0"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource TemplatedParent}}"
                                               TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                                    <Border Width="38" Margin="0,5,5,5" HorizontalAlignment="Right"
                                            Background="#EDF4F7" CornerRadius="7">
                                        <Path Width="10" Height="6" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Data="M 0 0 L 5 5 L 10 0"
                                              Stroke="{StaticResource NavyBrush}" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Border>
                                </Grid>
                            </Border>
                            <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=InputRoot}" PopupAnimation="Fade">
                                <Border Width="{Binding ActualWidth, ElementName=InputRoot}" Margin="0,5,0,0"
                                        Padding="4" Background="White" BorderBrush="#C8D8DF"
                                        BorderThickness="1" CornerRadius="10">
                                    <ScrollViewer MaxHeight="260" CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputChrome" Property="BorderBrush" Value="#79A9BE" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputChrome" Property="BorderBrush" Value="#2F7EA4" />
                                <Setter TargetName="InputChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputChrome" Property="Background" Value="#F1F4F5" />
                                <Setter TargetName="InputChrome" Property="BorderBrush" Value="#D7E1E5" />
                                <Setter Property="Foreground" Value="#748792" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StationTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="Padding" Value="13,10" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C8D8DF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Ink900Brush}" />
            <Setter Property="CaretBrush" Value="{StaticResource NavyBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxChrome" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TextBoxChrome" Property="BorderBrush" Value="#79A9BE" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxChrome" Property="BorderBrush" Value="#2F7EA4" />
                                <Setter TargetName="TextBoxChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TextBoxChrome" Property="Background" Value="#F1F4F5" />
                                <Setter TargetName="TextBoxChrome" Property="BorderBrush" Value="#D7E1E5" />
                                <Setter Property="Foreground" Value="#748792" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StationReadOnlyFieldStyle" TargetType="Border">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="Background" Value="#F3F7F8" />
            <Setter Property="BorderBrush" Value="#D4E0E5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="StationActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="17,10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionChrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionChrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionChrome" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ActionChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionChrome" Property="Background" Value="#F1F4F5" />
                                <Setter TargetName="ActionChrome" Property="BorderBrush" Value="#D7E1E5" />
                                <Setter Property="Foreground" Value="#748792" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StationPrimaryActionStyle" TargetType="Button"
               BasedOn="{StaticResource StationActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource NavyBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource NavyBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="StationSecondaryActionStyle" TargetType="Button"
               BasedOn="{StaticResource StationActionButtonStyle}">
            <Setter Property="Background" Value="#F2F7F9" />
            <Setter Property="BorderBrush" Value="#B7CDD8" />
            <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
        </Style>
        <Style x:Key="StationDangerActionStyle" TargetType="Button"
               BasedOn="{StaticResource StationActionButtonStyle}">
            <Setter Property="Background" Value="#FFF1F1" />
            <Setter Property="BorderBrush" Value="#E7AFB3" />
            <Setter Property="Foreground" Value="#A2252C" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource SoftCanvasBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
            <StackPanel Margin="34,26,34,42" MaxWidth="1380" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Foreground="#2F7EA4" FontSize="11" FontWeight="Bold"
                                   Text="CONFIGURACIÓN OPERATIVA" />
                        <TextBlock Margin="0,7,0,0" FontSize="28" FontWeight="Bold" Text="Preparar estación" />
                        <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"
                                   Text="Seleccione una línea para preparar o gestionar su cargamento." />
                    </StackPanel>
                    <Border Grid.Column="1" Padding="12,7" VerticalAlignment="Center"
                            Background="#E7F7ED" CornerRadius="16">
                        <TextBlock Foreground="#207946" FontSize="10" FontWeight="Bold"
                                   Text="●  CATÁLOGO DISPONIBLE" />
                    </Border>
                </Grid>

                <Border Margin="0,18,0,0" Style="{StaticResource InfoAlertStyle}">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Text="{Binding StationSessionStatus}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}"
                                   AutomationProperties.LiveSetting="Polite"
                                   Text="{Binding Status}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="5*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" MinHeight="590" Padding="24"
                            Style="{StaticResource SurfaceCardStyle}">
                        <StackPanel>
                            <TextBlock MinHeight="25" FontSize="20" FontWeight="Bold"
                                       Text="{Binding ContextPanelTitle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock MinHeight="38" Margin="0,5,0,20"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="{Binding ContextPanelDescription}" TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" />

                            <Border Margin="0,0,0,18">
                                <TextBlock Text="Para modificar la operación, eleve temporalmente el acceso desde la barra superior."
                                           TextWrapping="Wrap" />
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource WarningAlertStyle}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlantManager}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="LÍNEA SELECCIONADA" />
                                    <ComboBox Style="{StaticResource StationComboBoxStyle}" DisplayMemberPath="Name"
                                              ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                                              AutomationProperties.Name="Línea del cargamento" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="CARGAMENTO" />
                                    <Border Style="{StaticResource StationReadOnlyFieldStyle}">
                                        <Grid>
                                            <Border Width="28" Height="28" Margin="0,0,8,0" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center" Background="#E6F3EA" CornerRadius="7">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="#23804A" FontWeight="Bold" Text="✓" />
                                            </Border>
                                            <TextBlock Margin="0,0,38,0" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Ink700Brush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Nuevo · inicio automático" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelectedLineActive}" Value="True">
                                                            <Setter Property="Text" Value="Activo · cargamento en curso" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="PROVEEDOR" />
                                    <ComboBox DisplayMemberPath="Name"
                                              ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"
                                              AutomationProperties.Name="Proveedor del cargamento">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource StationComboBoxStyle}">
                                                <Setter Property="IsEnabled" Value="True" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelectedLineActive}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="RESPONSABLE PRINCIPAL O NUEVO RESPONSABLE" />
                                    <ComboBox Style="{StaticResource StationComboBoxStyle}" DisplayMemberPath="Name"
                                              ItemsSource="{Binding Workers}" SelectedItem="{Binding SelectedWorker}"
                                              AutomationProperties.Name="Responsable principal" />
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.ColumnSpan="3">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="NOTA DEL TURNO (OPCIONAL)" />
                                    <TextBox Style="{StaticResource StationTextBoxStyle}" AcceptsReturn="True"
                                             Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Nota del turno" />
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,18,0,0" Padding="12"
                                    Style="{StaticResource WarningAlertStyle}">
                                <TextBlock AutomationProperties.LiveSetting="Polite"
                                           Text="{Binding PreparationSummary}" TextWrapping="Wrap" />
                            </Border>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,4,0"
                                        Click="OnRequestStart" IsEnabled="{Binding CanRequestStart}"
                                        AutomationProperties.Name="Preparar línea">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource StationPrimaryActionStyle}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelectedLineActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,8,0" FontSize="17" Text="＋" />
                                        <TextBlock VerticalAlignment="Center" Text="PREPARAR LÍNEA" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="0" Margin="0,0,4,0" Click="OnRequestRelief"
                                        IsEnabled="{Binding CanRequestRelief}"
                                        AutomationProperties.Name="Cambiar responsable">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource StationSecondaryActionStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelectedLineActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,8,0" FontSize="17" Text="⇄" />
                                        <TextBlock VerticalAlignment="Center" Text="CAMBIAR RESPONSABLE" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Margin="4,0" Click="OnRequestCompletion"
                                        IsEnabled="{Binding CanRequestCompletion}"
                                        AutomationProperties.Name="Finalizar cargamento">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource StationDangerActionStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelectedLineActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,8,0" FontSize="15" Text="■" />
                                        <TextBlock VerticalAlignment="Center" Text="FINALIZAR CARGAMENTO" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Margin="4,0,0,0"
                                        Style="{StaticResource StationSecondaryActionStyle}"
                                        Command="{Binding DataContext.ShowOperationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        AutomationProperties.Name="Ir a operación">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,8,0" FontSize="17" Text="→" />
                                        <TextBlock VerticalAlignment="Center" Text="IR A OPERACIÓN" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Padding="22" Style="{StaticResource SurfaceCardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="20" FontWeight="Bold" Text="Estado de las líneas" />
                            <TextBlock Margin="0,4,0,15" Foreground="{StaticResource MutedBrush}"
                                       Text="Seleccione una línea para ver o gestionar su información." />
                            <ItemsControl ItemsSource="{Binding LineStatuses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,0,8" MinHeight="0" Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                BorderBrush="{StaticResource SoftBorderBrush}"
                                                Command="{Binding DataContext.SelectLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Background" Value="#F8FAFB" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#EEF6FA" />
                                                            <Setter Property="BorderBrush" Value="#76A9C1" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Grid Margin="13">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="6" Height="48" Margin="0,0,12,0"
                                                        VerticalAlignment="Center" Background="{Binding AccentColor}"
                                                        CornerRadius="3" />
                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontWeight="Bold" Text="{Binding Name}" />
                                                        <Border Width="8" Height="8" Margin="8,4,0,0" CornerRadius="4">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#92A2AC" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPrepared}" Value="True">
                                                                            <Setter Property="Background" Value="#1F9D55" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}"
                                                               FontSize="11" Text="{Binding Detail}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                                                           Foreground="#2F7EA4" FontWeight="Bold" Text="›" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="ConfirmationOverlay" Panel.ZIndex="80" Visibility="Collapsed" Background="#8A172631">
            <Border Width="500" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource SurfaceCardStyle}" CornerRadius="20">
                <StackPanel>
                    <TextBlock x:Name="ConfirmationTitle" FontSize="23" FontWeight="Bold"
                               Text="Confirmar acción" />
                    <TextBlock x:Name="ConfirmationMessage" Margin="0,11,0,22"
                               Foreground="{StaticResource Ink700Brush}" FontSize="14" LineHeight="21"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource StationSecondaryActionStyle}"
                                Click="OnCancelConfirmation" Content="NO, VOLVER" />
                        <Button x:Name="ConfirmationButton" Margin="9,0,0,0"
                                Style="{StaticResource StationActionButtonStyle}"
                                Click="OnConfirmAction" Background="#E7F7ED" BorderBrush="#A8D6BA"
                                Foreground="#176B3B" Content="SÍ, CONFIRMAR" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
