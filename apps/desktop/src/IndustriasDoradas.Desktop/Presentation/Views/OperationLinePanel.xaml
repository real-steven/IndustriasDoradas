<UserControl x:Class="IndustriasDoradas.Desktop.Presentation.Views.OperationLinePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Panel de línea piloto">
    <UserControl.Resources>
        <Style x:Key="PrimaryOperationButton" TargetType="Button">
            <Setter Property="MinWidth" Value="360" />
            <Setter Property="MinHeight" Value="112" />
            <Setter Property="Padding" Value="36,24" />
            <Setter Property="Foreground" Value="{StaticResource Ink900Brush}" />
            <Setter Property="Background" Value="{StaticResource Gold500Brush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Resources>

    <Border Padding="32"
            AutomationProperties.HelpText="Línea seleccionada para el registro local"
            Background="{StaticResource SurfaceBrush}"
            CornerRadius="18">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Line.IsReady}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Gold500Brush}" />
                        <Setter Property="BorderThickness" Value="3" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Foreground="{StaticResource Ink900Brush}"
                           FontSize="34"
                           FontWeight="Bold"
                           Text="{Binding Line.LineName}" />
                <Border Grid.Column="1"
                        Padding="14,7"
                        Background="{StaticResource Gold100Brush}"
                        CornerRadius="14">
                    <TextBlock Foreground="#76500A"
                               FontSize="13"
                               FontWeight="Bold"
                               Text="{Binding Line.StateLabel}" />
                </Border>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <TextBlock Foreground="{StaticResource Ink700Brush}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Text="{Binding Line.FeedDescription}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="{StaticResource Ink700Brush}"
                           FontSize="16"
                           Text="{Binding Line.ResponsibleDescription}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="#667085"
                           FontSize="14"
                           Text="{Binding Line.PreviousResponsibleDescription}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Line.HasPreviousResponsible}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Margin="0,8,0,0"
                           Foreground="#667085"
                           FontSize="14"
                           Text="{Binding Line.WorkPeriodDescription}" />
            </StackPanel>

            <Border Grid.Row="2"
                    Margin="0,26,0,0"
                    Padding="24,18"
                    Background="{StaticResource CanvasBrush}"
                    CornerRadius="14">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="#667085"
                               FontSize="13"
                               FontWeight="Bold"
                               Text="TOTAL DEL CARGAMENTO" />
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{StaticResource Ink900Brush}"
                               FontSize="72"
                               FontWeight="Bold"
                               LineHeight="78"
                               Text="{Binding Line.Total}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="4" Margin="0,26,0,0" HorizontalAlignment="Center">
                <Button AutomationProperties.HelpText="Registra una cajuela en el almacenamiento local"
                        AutomationProperties.Name="Registrar cajuela"
                        Command="{Binding RegisterCajuelaCommand}"
                        Content="REGISTRAR CAJUELA"
                        Style="{StaticResource PrimaryOperationButton}" />
                <Button Margin="0,12,0,0"
                        MinWidth="260"
                        AutomationProperties.Name="Corregir última cajuela"
                        Command="{Binding PrepareCorrectionCommand}"
                        Content="Corregir última cajuela" />
            </StackPanel>

            <Border Grid.Row="5"
                    Margin="0,24,0,0"
                    Padding="22"
                    Background="#FFF7E8"
                    BorderBrush="#E7BD65"
                    BorderThickness="1"
                    CornerRadius="12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCorrectionPending}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Ink900Brush}"
                               FontSize="18"
                               FontWeight="Bold"
                               Text="Confirmar corrección inmediata" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{StaticResource Ink700Brush}"
                               FontSize="15"
                               Text="{Binding CorrectionSummary}"
                               TextWrapping="Wrap" />
                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                        <Button AutomationProperties.Name="Confirmar corrección de última cajuela"
                                Command="{Binding ConfirmCorrectionCommand}"
                                Content="Sí, corregir última" />
                        <Button Margin="10,0,0,0"
                                AutomationProperties.Name="Cancelar corrección"
                                Command="{Binding CancelCorrectionCommand}"
                                Content="Cancelar" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
