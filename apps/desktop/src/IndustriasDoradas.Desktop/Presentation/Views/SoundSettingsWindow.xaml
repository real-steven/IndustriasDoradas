<Window x:Class="IndustriasDoradas.Desktop.Presentation.Views.SoundSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sonidos y respuesta · Industrias Doradas"
        Width="760" Height="640" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False" Background="#F3F7F8"
        AutomationProperties.Name="Configuración de sonidos">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <Style x:Key="RowActionStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Foreground="#2F7EA4" FontSize="11" FontWeight="Bold" Text="PREFERENCIA LOCAL DE ESTA ESTACIÓN" />
            <TextBlock Margin="0,6,0,0" FontSize="26" FontWeight="Bold" Text="Sonidos y respuesta" />
            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       Text="Elija un archivo WAV para cada acción. Se guarda una copia en este equipo y no se sincroniza. La respuesta visual se mantiene siempre." />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,12" Padding="16,12" Style="{StaticResource SurfaceCardStyle}" CornerRadius="12">
            <StackPanel>
                <CheckBox x:Name="EnabledBox" FontWeight="SemiBold" VerticalContentAlignment="Center"
                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                          IsEnabled="{Binding IsAllowedByStation}"
                          Content="Reproducir sonidos durante la operación"
                          AutomationProperties.Name="Activar sonidos de respuesta" />
                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                           Text="{Binding StationPolicyText}"
                           Visibility="{Binding ShowStationPolicy, Converter={StaticResource VisibleWhenTrue}}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SurfaceCardStyle}" CornerRadius="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                <ItemsControl x:Name="ActionsList" ItemsSource="{Binding Actions}"
                              AutomationProperties.Name="Sonidos por acción">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14,10" BorderBrush="{StaticResource SoftBorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Label}" TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                        <TextBlock Foreground="{StaticResource Ink700Brush}" Text="{Binding AssignedName}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding AssignedName}" />
                                        <TextBlock Margin="0,2,0,0" Foreground="{StaticResource DangerBrush}" FontSize="11"
                                                   Text="{Binding Warning}" TextWrapping="Wrap"
                                                   Visibility="{Binding HasWarning, Converter={StaticResource VisibleWhenTrue}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource RowActionStyle}" Content="Elegir…"
                                                Command="{Binding ChooseCommand}"
                                                ToolTip="Elegir un archivo WAV"
                                                AutomationProperties.Name="{Binding ChooseAutomationName}" />
                                        <Button Style="{StaticResource RowActionStyle}" Content="▶ Probar"
                                                Command="{Binding PreviewCommand}"
                                                ToolTip="Escuchar el sonido asignado"
                                                AutomationProperties.Name="{Binding PreviewAutomationName}" />
                                        <Button Style="{StaticResource RowActionStyle}" Content="Restaurar"
                                                Command="{Binding RestoreCommand}"
                                                ToolTip="Volver al sonido predeterminado"
                                                AutomationProperties.Name="{Binding RestoreAutomationName}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource NavyBrush}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" Text="{Binding Status}" />
            <Button Grid.Column="1" Margin="12,0,0,0" MinWidth="110" IsCancel="True" IsDefault="True"
                    Background="{StaticResource NavyBrush}" BorderBrush="{StaticResource NavyBrush}" Foreground="White"
                    Content="Listo" Click="OnClose" />
        </Grid>
    </Grid>
</Window>
