<Window x:Class="IndustriasDoradas.Desktop.Presentation.Views.CloseStationConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cerrar estación · Industrias Doradas"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#F3F7F8"
        FocusManager.FocusedElement="{Binding ElementName=CancelButton}"
        AutomationProperties.Name="Confirmar cierre de la estación">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
    </Window.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Foreground="#2F7EA4" FontSize="11" FontWeight="Bold" Text="SESIÓN DE ESTA ESTACIÓN" />
            <TextBlock Margin="0,6,0,0" FontSize="26" FontWeight="Bold" Text="Cerrar estación" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,0" Padding="16,14" Style="{StaticResource SurfaceCardStyle}" CornerRadius="12">
            <StackPanel>
                <TextBlock x:Name="MessageText" Foreground="{StaticResource Ink700Brush}" TextWrapping="Wrap"
                           Text="Cerrar la estación y volver al inicio de sesión." />
                <StackPanel x:Name="ProgressPanel" Margin="0,12,0,0"
                            Visibility="{Binding IsClosing, Converter={StaticResource VisibleWhenTrue}}">
                    <ProgressBar Height="6" IsIndeterminate="True"
                                 Foreground="{StaticResource NavyBrush}" Background="{StaticResource SoftBorderBrush}"
                                 BorderThickness="0" AutomationProperties.Name="Cerrando la estación" />
                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12"
                               AutomationProperties.LiveSetting="Polite"
                               Text="Cerrando la estación…" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" MinWidth="110"
                    Content="Cancelar" Command="{Binding CancelCommand}"
                    AutomationProperties.Name="Cancelar y seguir en la estación" />
            <Button x:Name="ConfirmButton" Margin="10,0,0,0" MinWidth="140"
                    Background="{StaticResource DangerBrush}" BorderBrush="{StaticResource DangerBrush}" Foreground="White"
                    Content="Cerrar estación" Command="{Binding ConfirmCommand}"
                    AutomationProperties.Name="Cerrar estación y volver al inicio de sesión" />
        </StackPanel>
    </Grid>
</Window>
