<Window x:Class="IndustriasDoradas.Desktop.Presentation.Views.OperationLineDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vista de línea · Industrias Doradas"
        Width="1080" Height="760" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/IndustriasDoradas.Desktop;component/Assets/logo-industrias-doradas.png"
        FontFamily="Segoe UI Variable Text" UseLayoutRounding="True"
        SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="{StaticResource SoftCanvasBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="26">
        <Border Padding="28" Background="White" BorderBrush="{StaticResource SoftBorderBrush}"
                BorderThickness="1" CornerRadius="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="LineAccentStrip" Height="9" Margin="-28,-28,-28,0"
                        VerticalAlignment="Top" Panel.ZIndex="2"
                        Background="{Binding Line.AccentColor}"
                        CornerRadius="22,22,0,0" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Foreground="#2F7EA4" FontSize="11" FontWeight="Bold"
                                   Text="VISTA DE MONITOR · SOLO VISUALIZACIÓN" />
                        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Ink900Brush}"
                                   FontSize="34" FontWeight="Bold" Text="{Binding Line.CardTitle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Padding="12,7" Background="#E7F7ED" CornerRadius="16">
                            <TextBlock Foreground="#207946" FontSize="10" FontWeight="Bold"
                                       Text="{Binding Line.StateLabel}" />
                        </Border>
                        <Button Margin="10,0,0,0" Padding="12,7" Click="OnToggleFullScreen"
                                Content="⛶  PANTALLA COMPLETA" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Margin="0,0,7,0" Padding="14" Background="#F8FAFB" CornerRadius="12">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Text="PROVEEDOR" />
                            <TextBlock Margin="0,5,0,0" FontSize="17" FontWeight="Bold" Text="{Binding Line.SupplierName}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Margin="7,0,0,0" Padding="14" Background="#F8FAFB" CornerRadius="12">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Text="RESPONSABLE" />
                            <TextBlock Margin="0,5,0,0" FontSize="17" FontWeight="Bold" Text="{Binding Line.ResponsibleName}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="0,24,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Margin="0,0,12,0" Padding="24" Background="#F7FAFB" CornerRadius="18">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="13" FontWeight="Bold"
                                       Text="CAJUELAS DEL CARGAMENTO" />
                            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Ink900Brush}"
                                       FontSize="112" FontWeight="Bold" LineHeight="118" Text="{Binding Line.Total}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <ToggleButton x:Name="SweepDetailsButton" Padding="18" HorizontalContentAlignment="Stretch"
                                      Background="#FFF9EB" BorderBrush="#EAD7A9"
                                      ToolTipService.ShowDuration="60000">
                            <ToggleButton.ToolTip>
                                <StackPanel MinWidth="220">
                                    <TextBlock Margin="0,0,0,7" FontWeight="Bold" Text="Cajuelas por barrida" />
                                    <ItemsControl ItemsSource="{Binding Line.Sweeps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                    <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding CajuelaDescription}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}" FontSize="10"
                                               Text="Haga clic para fijar el detalle." />
                                </StackPanel>
                            </ToggleButton.ToolTip>
                            <StackPanel>
                                <TextBlock HorizontalAlignment="Center" Foreground="#76500A" FontSize="11"
                                           FontWeight="Bold" Text="CANTIDAD DE BARRIDAS" />
                                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="42"
                                           FontWeight="Bold" Text="{Binding Line.SweepCount}" />
                                <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                           FontSize="10" Text="Pase el mouse o haga clic para ver el detalle" TextWrapping="Wrap" />
                            </StackPanel>
                        </ToggleButton>
                        <Popup Placement="Bottom" PlacementTarget="{Binding ElementName=SweepDetailsButton}"
                               IsOpen="{Binding IsChecked, ElementName=SweepDetailsButton}"
                               StaysOpen="True" AllowsTransparency="True">
                            <Border Margin="0,7,0,0" Padding="16" MinWidth="260" Background="White"
                                    BorderBrush="#CFE0E8" BorderThickness="1" CornerRadius="12">
                                <Border.Effect><DropShadowEffect BlurRadius="16" Opacity="0.18" ShadowDepth="4" /></Border.Effect>
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="Bold" Text="Cajuelas por barrida" />
                                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Line.Sweeps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10" Text="{Binding TimeDescription}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center"
                                                               FontWeight="Bold" Text="{Binding CajuelaDescription}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Margin="0,9,0,0" Foreground="{StaticResource MutedBrush}" FontSize="10"
                                               Text="Haga clic nuevamente en el contador para cerrar." />
                                </StackPanel>
                            </Border>
                        </Popup>

                        <Border Margin="0,12,0,0" Padding="16" Background="#F8FAFB" CornerRadius="14">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"
                                           Text="PRÓXIMAS ALERTAS" />
                                <TextBlock Margin="0,7,0,0" FontSize="17" FontWeight="Bold"
                                           Text="{Binding Line.NextMercuryAlertDescription}" />
                                <TextBlock Margin="0,4,0,0" FontSize="17" FontWeight="Bold"
                                           Text="{Binding Line.NextSweepAlertDescription}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="3">
                    <ProgressBar Height="18" Minimum="0" Maximum="{Binding Line.ProgressMaximum, Mode=OneWay}"
                                 Value="{Binding Line.ProgressValue, Mode=OneWay}" Foreground="{Binding Line.ProgressColor, Mode=OneWay}"
                                 Background="#E7EDEF" />
                    <Grid Margin="0,7,0,0">
                        <TextBlock HorizontalAlignment="Left" Foreground="#92A2AC" Text="0" />
                        <TextBlock HorizontalAlignment="Center" Foreground="#92A2AC" Text="CADA 50 · MERCURIO" />
                        <TextBlock HorizontalAlignment="Right" Foreground="#92A2AC" Text="{Binding Line.ProgressEndDescription}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Border Padding="28" Background="#FFF7E8" BorderBrush="#E7BD65" BorderThickness="1" CornerRadius="18">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLineAvailable}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center" FontSize="28" FontWeight="Bold" Text="Línea no disponible" />
                <TextBlock Margin="0,8,0,0" Text="La línea dejó de estar activa. Puede cerrar esta ventana." />
            </StackPanel>
        </Border>
    </Grid>
</Window>
