<UserControl x:Class="IndustriasDoradas.Desktop.Presentation.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource SoftCanvasBrush}">
        <StackPanel Margin="30,24,30,40" MaxWidth="1380" HorizontalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Foreground="#2F7EA4" FontSize="11" FontWeight="Bold"
                               Text="CONTROL LOCAL-FIRST" />
                    <TextBlock Margin="0,6,0,0" FontSize="28" FontWeight="Bold" Text="Inventario" />
                    <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"
                               Text="Movimientos y conteos que se conservan aunque no haya Internet." />
                </StackPanel>
                <Button Grid.Column="1" MinWidth="128" VerticalAlignment="Center"
                        Command="{Binding RefreshCommand}" Content="↻  ACTUALIZAR" />
            </Grid>

            <Border Margin="0,16,0,0" Padding="15" Background="#FFF8E9"
                    BorderBrush="#ECD58E" BorderThickness="1" CornerRadius="11">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="{Binding Freshness}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" Foreground="#6D5A28" FontSize="11"
                               Text="{Binding Status}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="22" Style="{StaticResource SurfaceCardStyle}">
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="Bold" Text="Existencias locales" />
                        <TextBlock Margin="0,4,0,14" Foreground="{StaticResource MutedBrush}"
                                   Text="Local incluye lo guardado en este equipo; central conocido excluye hechos aún pendientes." TextWrapping="Wrap" />
                        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                                 BorderThickness="0" Background="Transparent"
                                 AutomationProperties.Name="Artículos de inventario">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="14" Background="#F7F9FA"
                                            BorderBrush="#DCE6EA" BorderThickness="1" CornerRadius="11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontWeight="Bold" Text="{Binding Name}" />
                                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}"
                                                           FontSize="11" Text="{Binding TypeName}" />
                                                <TextBlock Margin="0,3,0,0" Foreground="#2F7EA4"
                                                           FontSize="11" Text="{Binding PendingLabel}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="18,0,0,0" HorizontalAlignment="Right">
                                                <TextBlock HorizontalAlignment="Right" FontSize="18" FontWeight="Bold"
                                                           Text="{Binding LocalBalance}" />
                                                <TextBlock Margin="0,3,0,0" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource MutedBrush}" FontSize="11"
                                                           Text="{Binding CentralBalance, StringFormat=Central: {0}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Padding="22" Style="{StaticResource SurfaceCardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="20" FontWeight="Bold" Text="Registrar movimiento" />
                            <TextBlock Margin="0,5,0,14" Foreground="{StaticResource MutedBrush}"
                                       Text="{Binding SelectedItemSummary}" TextWrapping="Wrap" />
                            <TextBlock FontSize="11" FontWeight="Bold" Text="TIPO" />
                            <ComboBox MinHeight="42" Margin="0,6,0,12" Padding="10,5"
                                      ItemsSource="{Binding MovementTypes}"
                                      SelectedItem="{Binding SelectedMovement}" DisplayMemberPath="Name" />
                            <StackPanel Visibility="{Binding RequiresQuantity, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock FontSize="11" FontWeight="Bold" Text="CANTIDAD" />
                                <TextBox MinHeight="42" Margin="0,6,0,3" Padding="10"
                                         Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,0,0,10" Foreground="{StaticResource MutedBrush}"
                                           FontSize="10" Text="{Binding QuantityHint}" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding AllowsRelatedMovement, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock FontSize="11" FontWeight="Bold" Text="{Binding RelatedMovementLabel}" />
                                <ComboBox MinHeight="42" Margin="0,6,0,4" Padding="10,5"
                                          ItemsSource="{Binding RelatedMovements}"
                                          SelectedItem="{Binding SelectedRelatedMovement}"
                                          DisplayMemberPath="Description" />
                                <TextBlock Margin="0,0,0,10" Foreground="{StaticResource MutedBrush}"
                                           FontSize="10" Text="El reintegro puede quedar sin vínculo; la anulación siempre exige el original." TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding AllowsWorker, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock FontSize="11" FontWeight="Bold" Text="RESPONSABLE OPCIONAL" />
                                <ComboBox MinHeight="42" Margin="0,6,0,12" Padding="10,5"
                                          ItemsSource="{Binding Workers}" SelectedItem="{Binding SelectedWorker}"
                                          DisplayMemberPath="Name" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding RequiresReason, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock FontSize="11" FontWeight="Bold" Text="MOTIVO OBLIGATORIO" />
                                <TextBox MinHeight="42" Margin="0,6,0,12" Padding="10"
                                         Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <TextBlock FontSize="11" FontWeight="Bold" Text="DESTINO OPCIONAL" />
                            <TextBox MinHeight="42" Margin="0,6,0,12" Padding="10"
                                     Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock FontSize="11" FontWeight="Bold" Text="OBSERVACIÓN OPCIONAL" />
                            <TextBox MinHeight="58" Margin="0,6,0,14" Padding="10" AcceptsReturn="True"
                                     TextWrapping="Wrap" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                            <Button MinHeight="48" Command="{Binding RecordMovementCommand}"
                                    Content="GUARDAR MOVIMIENTO LOCAL" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0" Padding="22" Style="{StaticResource SurfaceCardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="20" FontWeight="Bold" Text="Conteo físico" />
                            <TextBlock Margin="0,5,0,12" Foreground="{StaticResource MutedBrush}"
                                       Text="Registra el conteo del artículo seleccionado sin cambiar el kardex." TextWrapping="Wrap" />
                            <TextBlock FontSize="11" FontWeight="Bold" Text="CANTIDAD CONTADA" />
                            <TextBox MinHeight="42" Margin="0,6,0,12" Padding="10"
                                     Text="{Binding CountedQuantity, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock FontSize="11" FontWeight="Bold" Text="OBSERVACIÓN OPCIONAL" />
                            <TextBox MinHeight="54" Margin="0,6,0,14" Padding="10" AcceptsReturn="True"
                                     TextWrapping="Wrap" Text="{Binding ReviewNotes, UpdateSourceTrigger=PropertyChanged}" />
                            <Button MinHeight="46" Command="{Binding RecordReviewCommand}"
                                    Content="GUARDAR CONTEO LOCAL" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="22" Style="{StaticResource SurfaceCardStyle}">
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="Bold" Text="Componentes de rastra" />
                        <TextBlock Margin="0,5,0,14" Foreground="{StaticResource MutedBrush}"
                                   Text="Instalar, retirar o reemplazar conserva la historia y no descuenta inventario automáticamente."
                                   TextWrapping="Wrap" />
                        <TextBlock FontSize="11" FontWeight="Bold" Text="RASTRA" />
                        <ComboBox MinHeight="42" Margin="0,6,0,12" Padding="10,5"
                                  ItemsSource="{Binding Rastras}" SelectedItem="{Binding SelectedRastra}"
                                  DisplayMemberPath="DisplayName" />
                        <TextBlock FontSize="11" FontWeight="Bold" Text="ACCIÓN" />
                        <ComboBox MinHeight="42" Margin="0,6,0,4" Padding="10,5"
                                  ItemsSource="{Binding ComponentActions}"
                                  SelectedItem="{Binding SelectedComponentAction}" DisplayMemberPath="Name" />
                        <TextBlock Margin="0,0,0,12" Foreground="{StaticResource MutedBrush}"
                                   FontSize="10" Text="{Binding ComponentActionHelp}" TextWrapping="Wrap" />
                        <StackPanel Visibility="{Binding ComponentNeedsExisting, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock FontSize="11" FontWeight="Bold" Text="INSTALACIÓN ACTIVA" />
                            <ComboBox MinHeight="42" Margin="0,6,0,12" Padding="10,5"
                                      ItemsSource="{Binding ActiveInstallations}"
                                      SelectedItem="{Binding SelectedInstallation}" DisplayMemberPath="DisplayName" />
                            <TextBlock FontSize="11" FontWeight="Bold" Text="CONDICIÓN AL RETIRAR" />
                            <TextBox MinHeight="42" Margin="0,6,0,12" Padding="10"
                                     Text="{Binding RemovedCondition, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock FontSize="11" FontWeight="Bold" Text="MOTIVO" />
                            <TextBox MinHeight="42" Margin="0,6,0,12" Padding="10"
                                     Text="{Binding ComponentReason, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding ComponentNeedsNewItem, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock FontSize="11" FontWeight="Bold" Text="ARTÍCULO INSTALADO" />
                            <ComboBox MinHeight="42" Margin="0,6,0,12" Padding="10,5"
                                      ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedComponentItem}"
                                      DisplayMemberPath="Name" />
                            <TextBlock FontSize="11" FontWeight="Bold" Text="CANTIDAD" />
                            <TextBox MinHeight="42" Margin="0,6,0,12" Padding="10"
                                     Text="{Binding ComponentQuantity, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock FontSize="11" FontWeight="Bold" Text="IDENTIFICADOR OPCIONAL" />
                            <TextBox MinHeight="42" Margin="0,6,0,12" Padding="10"
                                     Text="{Binding ComponentIdentifier, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock FontSize="11" FontWeight="Bold" Text="CONDICIÓN AL INSTALAR" />
                            <TextBox MinHeight="42" Margin="0,6,0,12" Padding="10"
                                     Text="{Binding InstalledCondition, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <TextBlock FontSize="11" FontWeight="Bold" Text="OBSERVACIÓN OPCIONAL" />
                        <TextBox MinHeight="54" Margin="0,6,0,14" Padding="10" AcceptsReturn="True"
                                 TextWrapping="Wrap" Text="{Binding ComponentNotes, UpdateSourceTrigger=PropertyChanged}" />
                        <Button MinHeight="46" Command="{Binding RecordComponentChangeCommand}"
                                Content="GUARDAR CAMBIO LOCAL" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="22" Style="{StaticResource SurfaceCardStyle}">
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="Bold" Text="Novedades operativas" />
                        <TextBlock Margin="0,5,0,14" Foreground="{StaticResource MutedBrush}"
                                   Text="Explique paros, mantenimiento, emergencias, feriados u otros hechos. No crea órdenes de trabajo."
                                   TextWrapping="Wrap" />
                        <TextBlock FontSize="11" FontWeight="Bold" Text="CATEGORÍA OPCIONAL" />
                        <ComboBox MinHeight="42" Margin="0,6,0,12" Padding="10,5"
                                  ItemsSource="{Binding NoveltyCategories}"
                                  SelectedItem="{Binding SelectedNoveltyCategory}" DisplayMemberPath="Name" />
                        <CheckBox Margin="0,0,0,12" IsChecked="{Binding NoveltyIsPlantWide}"
                                  Content="Aplica a toda la planta" />
                        <StackPanel Visibility="{Binding NoveltyNeedsLine, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock FontSize="11" FontWeight="Bold" Text="LÍNEA" />
                            <ComboBox MinHeight="42" Margin="0,6,0,12" Padding="10,5"
                                      ItemsSource="{Binding NoveltyLines}"
                                      SelectedItem="{Binding SelectedNoveltyLine}" DisplayMemberPath="Name" />
                        </StackPanel>
                        <TextBlock FontSize="11" FontWeight="Bold" Text="DESCRIPCIÓN" />
                        <TextBox MinHeight="70" Margin="0,6,0,14" Padding="10" AcceptsReturn="True"
                                 TextWrapping="Wrap" Text="{Binding NoveltyDescription, UpdateSourceTrigger=PropertyChanged}" />
                        <Button MinHeight="46" Command="{Binding OpenNoveltyCommand}"
                                Content="ABRIR NOVEDAD LOCAL" />

                        <TextBlock Margin="0,22,0,0" FontSize="16" FontWeight="Bold"
                                   Text="Novedades abiertas" />
                        <ComboBox MinHeight="42" Margin="0,8,0,4" Padding="10,5"
                                  ItemsSource="{Binding OpenNovelties}"
                                  SelectedItem="{Binding SelectedOpenNovelty}" DisplayMemberPath="DisplayName" />
                        <TextBlock Margin="0,0,0,12" Foreground="{StaticResource MutedBrush}" FontSize="10"
                                   Text="{Binding SelectedOpenNovelty.StatusLabel}" TextWrapping="Wrap" />
                        <Button MinHeight="46" Command="{Binding CloseNoveltyCommand}"
                                Content="CERRAR NOVEDAD LOCAL" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
