<Window x:Class="IndustriasDoradas.Desktop.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:IndustriasDoradas.Desktop.Presentation.ViewModels"
        xmlns:views="clr-namespace:IndustriasDoradas.Desktop.Presentation.Views"
        mc:Ignorable="d"
        Title="Industrias Doradas"
        Width="1280"
        Height="800"
        MinWidth="1050"
        MinHeight="650"
        Icon="pack://application:,,,/Assets/logo-industrias-doradas.png"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="{StaticResource SoftCanvasBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate DataType="{x:Type viewModels:HomeViewModel}"><views:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:DiagnosticsViewModel}"><views:DiagnosticsView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:StationViewModel}"><views:StationView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:OperationViewModel}"><views:OperationView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AuditViewModel}"><views:AuditView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AttendancePreviewViewModel}"><views:AttendancePreviewView /></DataTemplate>

        <Style x:Key="NavButtonStyle" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#516A79" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavChrome" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="#E8F3F8" />
                                <Setter TargetName="NavChrome" Property="BorderBrush" Value="#BFD8E4" />
                                <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavChrome" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <!-- Módulos protegidos sin Modo Jefe de Planta: visibles pero inactivos. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="NavChrome" Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderActionStyle" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Background" Value="#F5F8F9" />
            <Setter Property="BorderBrush" Value="#D5E1E6" />
            <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>

    <Grid>
        <views:LoginView DataContext="{Binding Station}">
            <views:LoginView.Style>
                <Style TargetType="views:LoginView">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsApplicationUnlocked}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:LoginView.Style>
        </views:LoginView>

        <Grid x:Name="ApplicationShell">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsApplicationUnlocked}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="76" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="HeaderPanel" Grid.Row="0" Panel.ZIndex="20"
                    Background="White" BorderBrush="{StaticResource SoftBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="215" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="13" ClipToBounds="True">
                            <Image Source="pack://application:,,,/Assets/logo-industrias-doradas.png"
                                   Stretch="UniformToFill"
                                   AutomationProperties.Name="Logo de Industrias Doradas" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Foreground="{StaticResource Ink900Brush}" FontWeight="Bold"
                                       Text="INDUSTRIAS DORADAS" />
                            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11"
                                       Text="{Binding CurrentPageTitle}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button AutomationProperties.Name="Ir al inicio" Command="{Binding ShowHomeCommand}"
                                Content="⌂  INICIO">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHomePage}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource NavyBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource NavyBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button AutomationProperties.Name="Ir a modo operación" Command="{Binding ShowOperationCommand}"
                                Content="🪣  OPERACIÓN">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOperationPage}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource NavyBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource NavyBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button AutomationProperties.Name="Ir a asistencia" Command="{Binding ShowAttendanceCommand}"
                                Content="◷  ASIST." ToolTip="Registrar entrada y salida">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAttendancePage}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource NavyBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource NavyBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button AutomationProperties.Name="Ir a estación" Command="{Binding ShowStationCommand}"
                                Content="⚙  ESTACIÓN">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStationPage}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource NavyBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource NavyBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button AutomationProperties.Name="Ir a auditoría" Command="{Binding ShowAuditCommand}"
                                Content="▤  AUDITORÍA">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAuditPage}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource NavyBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource NavyBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button AutomationProperties.Name="Ir a diagnóstico" Command="{Binding ShowDiagnosticsCommand}"
                                Content="♥  ESTADO">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDiagnosticsPage}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource NavyBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource NavyBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button AutomationProperties.Name="Ir a configuración" Command="{Binding ShowSettingsCommand}"
                                Content="⌨  CONFIG.">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource NavyBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource NavyBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderClock" HorizontalAlignment="Right"
                                       Foreground="{StaticResource Ink900Brush}" FontSize="18"
                                       FontWeight="Bold" Text="00:00" />
                            <TextBlock x:Name="HeaderDate" HorizontalAlignment="Right"
                                       Foreground="{StaticResource MutedBrush}" FontSize="9" Text="—" />
                        </StackPanel>
                        <Button x:Name="FullScreenButton" MinWidth="40" Margin="0,0,7,0"
                                Style="{StaticResource HeaderActionStyle}"
                                Click="OnToggleFullScreen" Content="⛶"
                                ToolTip="Pantalla completa (F11)"
                                AutomationProperties.Name="Activar pantalla completa" />
                        <Button Margin="0,0,7,0" Click="OnElevationClick">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HeaderActionStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlantManager}" Value="True">
                                            <Setter Property="Background" Value="#FFF8E9" />
                                            <Setter Property="BorderBrush" Value="#E7B91F" />
                                            <Setter Property="Foreground" Value="#815D17" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlantManager}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border Width="27" Height="27" Margin="0,0,8,0"
                                            Background="{StaticResource LockYellowBrush}"
                                            BorderBrush="#D9A900" BorderThickness="1" CornerRadius="7">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontFamily="Segoe UI Emoji" FontSize="14" Text="🔒" />
                                    </Border>
                                    <TextBlock VerticalAlignment="Center" Text="ELEVAR ACCESO" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlantManager}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border Width="27" Height="27" Margin="0,0,8,0"
                                            Background="{StaticResource LockYellowBrush}"
                                            BorderBrush="#D9A900" BorderThickness="1" CornerRadius="7">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontFamily="Segoe UI Emoji" FontSize="14" Text="🔓" />
                                    </Border>
                                    <TextBlock VerticalAlignment="Center" Text="MODO JEFE ACTIVO" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Grid x:Name="ProfileAvatarHost" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Button x:Name="ProfileAvatarButton" Width="38" Height="38" MinHeight="0" Padding="0"
                                    Cursor="Hand" Click="OnProfileAvatarClick"
                                    ToolTip="Ver mi perfil"
                                    AutomationProperties.Name="{Binding DisplayName, StringFormat=Perfil de {0}}"
                                    AutomationProperties.HelpText="Abre su perfil">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Ellipse x:Name="Ring" Fill="#517487" Stroke="Transparent" StrokeThickness="2" />
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="White" FontWeight="Bold" Text="{Binding Initials}"
                                                       Visibility="{Binding ShowInitials, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Ellipse Margin="2"
                                                     Visibility="{Binding HasPhoto, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Ring" Property="Stroke" Value="#E7B91F" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Ring" Property="Stroke" Value="#0874A3" />
                                                <Setter TargetName="Ring" Property="StrokeThickness" Value="3" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Popup x:Name="ProfilePopup" PlacementTarget="{Binding ElementName=ProfileAvatarButton}"
                                   Placement="Bottom" HorizontalOffset="-270" VerticalOffset="8"
                                   StaysOpen="True" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade">
                                <Border x:Name="ProfilePopupPanel" Width="310" Margin="0,0,10,10" Padding="16"
                                        Background="White" BorderBrush="#D6E1E6" BorderThickness="1" CornerRadius="14"
                                        KeyboardNavigation.TabNavigation="Cycle"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"
                                        PreviewKeyDown="OnProfilePopupKeyDown"
                                        AutomationProperties.Name="Mi perfil">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.22" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="52" Height="52">
                                                <Ellipse Fill="#517487" />
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="White" FontSize="17" FontWeight="Bold" Text="{Binding Initials}"
                                                           Visibility="{Binding ShowInitials, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <Ellipse Visibility="{Binding HasPhoto, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="15" FontWeight="Bold" TextWrapping="Wrap"
                                                           Foreground="{StaticResource Ink900Brush}" Text="{Binding DisplayName}" />
                                                <Border Margin="0,4,0,0" Padding="8,2" HorizontalAlignment="Left"
                                                        Background="#FFF3D9" CornerRadius="9">
                                                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="#6B4A00" Text="Jefe de planta" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Margin="0,12,0,0" FontSize="10" FontWeight="Bold" Foreground="#5F7480" Text="CORREO" />
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Ink900Brush}" Text="{Binding Email}" />
                                        <TextBlock Margin="0,8,0,0" FontSize="10" FontWeight="Bold" Foreground="#5F7480" Text="TELÉFONO" />
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Ink900Brush}" Text="{Binding PhoneText}" />
                                        <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="#8A6D1E" TextWrapping="Wrap"
                                                   Text="Sin conexión: se muestran los últimos datos conocidos."
                                                   Visibility="{Binding IsOfflineData, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Margin="0,8,0,0" FontSize="10" FontWeight="Bold" Foreground="#5F7480" Text="ACCESO" />
                                        <TextBlock Foreground="{StaticResource Ink900Brush}" Text="{Binding AccessStateText}" />

                                        <Border Margin="0,12,0,0" Padding="10,8" Background="#F2F7F9" CornerRadius="9"
                                                Visibility="{Binding IsReadOnly, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock TextWrapping="Wrap" Foreground="#536A77" FontSize="11"
                                                       Text="Eleve el acceso para modificar su fotografía o teléfono." />
                                        </Border>

                                        <StackPanel Margin="0,12,0,0"
                                                    Visibility="{Binding ShowElevatedActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Button x:Name="ProfileFirstAction" Margin="0,0,0,6" HorizontalContentAlignment="Left"
                                                    Command="{Binding BeginEditPhoneCommand}" Content="Cambiar teléfono" />
                                            <Button Margin="0,0,0,6" HorizontalContentAlignment="Left"
                                                    Command="{Binding ChangePhotoCommand}" Content="Cambiar fotografía" />
                                            <Button HorizontalContentAlignment="Left"
                                                    Command="{Binding RemovePhotoCommand}" Content="Quitar fotografía"
                                                    Visibility="{Binding HasPhoto, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock Margin="0,6,0,0" FontSize="10" Foreground="#5F7480" TextWrapping="Wrap"
                                                       Text="La fotografía se guarda solo en este equipo." />
                                        </StackPanel>

                                        <StackPanel Margin="0,12,0,0"
                                                    Visibility="{Binding ShowPhoneEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Label Padding="0" Target="{Binding ElementName=ProfilePhoneBox}" FontSize="11" FontWeight="Bold"
                                                   Foreground="#5F7480" Content="_Teléfono (opcional)" />
                                            <TextBox x:Name="ProfilePhoneBox" Margin="0,4,0,0" MaxLength="24"
                                                     Text="{Binding PhoneDraft, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Teléfono (opcional)" />
                                            <Label Padding="0" Margin="0,8,0,0" Target="{Binding ElementName=ProfilePinBox}" FontSize="11"
                                                   FontWeight="Bold" Foreground="#5F7480" Content="_PIN para confirmar en la central" />
                                            <PasswordBox x:Name="ProfilePinBox" Margin="0,4,0,0" MaxLength="12"
                                                         KeyDown="OnProfilePinKeyDown"
                                                         AutomationProperties.Name="PIN para confirmar en la central" />
                                            <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="#5F7480" TextWrapping="Wrap"
                                                       Text="Requiere conexión a Internet. Ejemplos: 8888-7777 o +1 415 555 0100." />
                                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Command="{Binding CancelEditCommand}" Content="Cancelar" />
                                                <Button Margin="8,0,0,0" Click="OnProfileSavePhone"
                                                        Background="{StaticResource NavyBrush}" BorderBrush="{StaticResource NavyBrush}"
                                                        Foreground="White" Content="Guardar"
                                                        IsEnabled="{Binding ShowPhoneEditor}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="9"
                                                Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E7F6EC" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                                            <Setter Property="Background" Value="#FDECEA" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock TextWrapping="Wrap" FontSize="11" Text="{Binding StatusMessage}"
                                                       AutomationProperties.LiveSetting="Polite" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <Button Click="OnCloseStation" ToolTip="Cerrar la sesión de esta estación"
                                Background="#F7F5F0" BorderBrush="#DED8CB" Foreground="#665B48"
                                Content="↪  CERRAR ESTACIÓN" FontSize="11" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
                <StackPanel Panel.ZIndex="30" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Button x:Name="ShowHeaderButton" Visibility="Collapsed"
                            Margin="0,-1,0,0" Padding="15,5" MinHeight="31"
                            Click="OnShowHeader" Content="⌄  MOSTRAR MENÚ"
                            Background="White" BorderBrush="#D6E1E6" Foreground="{StaticResource NavyBrush}"
                            FontSize="11" FontWeight="Bold" />
                    <Button x:Name="FloatingFullScreenExitButton" Visibility="Collapsed"
                            Width="40" Height="32" MinHeight="0" Margin="7,-1,0,0" Padding="0"
                            Background="#173B50" BorderBrush="#173B50" Foreground="White"
                            FontSize="16" Click="OnToggleFullScreen" Content="↙"
                            ToolTip="Salir de pantalla completa (F11 o Esc)"
                            AutomationProperties.Name="Salir de pantalla completa" />
                </StackPanel>
                <StackPanel Panel.ZIndex="25" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,16,22,0">
                    <Border Margin="0,0,0,8" Padding="13,9"
                            Background="#FFF0EA" BorderBrush="#E6B7A4" BorderThickness="1"
                            CornerRadius="12"
                            Visibility="{Binding HasResponsibilityWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock MaxWidth="450" VerticalAlignment="Center" Foreground="#85402B"
                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                       Text="{Binding ResponsibilityWarning}" />
                            <Button Grid.Column="1" Margin="14,0,0,0" Padding="11,6"
                                    Background="White" BorderBrush="#DCA38D" Foreground="#85402B"
                                    FontSize="10" FontWeight="Bold"
                                    Command="{Binding ShowStationResponsibilityCommand}"
                                    Content="IR A ESTACIÓN"
                                    AutomationProperties.Name="Ir a la línea con responsable ausente" />
                            <Button Grid.Column="2" Width="30" Height="30" Margin="7,0,0,0" Padding="0"
                                    Background="Transparent" BorderBrush="Transparent" Foreground="#85402B"
                                    FontSize="14" FontWeight="Bold"
                                    Command="{Binding DismissResponsibilityWarningCommand}"
                                    Content="✕" ToolTip="Cerrar notificación"
                                    AutomationProperties.Name="Cerrar aviso de responsable ausente" />
                        </Grid>
                    </Border>
                    <Border Padding="13,9"
                            Background="#FFF5D7" BorderBrush="#E4D39D" BorderThickness="1"
                            CornerRadius="12"
                            Visibility="{Binding HasCorrectionNotification, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Foreground="#76500A"
                                       FontWeight="SemiBold" Text="{Binding CorrectionNotification}" />
                            <Button Grid.Column="1" Margin="14,0,0,0" Padding="11,6"
                                    Background="White" BorderBrush="#D7BF78" Foreground="#76500A"
                                    FontSize="10" FontWeight="Bold"
                                    Command="{Binding ShowAuditCorrectionsCommand}"
                                    Content="ABRIR AUDITORÍA"
                                    AutomationProperties.Name="Abrir auditoría de correcciones" />
                            <Button Grid.Column="2" Width="30" Height="30" Margin="7,0,0,0" Padding="0"
                                    Background="Transparent" BorderBrush="Transparent" Foreground="#76500A"
                                    FontSize="14" FontWeight="Bold"
                                    Command="{Binding DismissCorrectionNotificationCommand}"
                                    Content="✕" ToolTip="Cerrar notificación"
                                    AutomationProperties.Name="Cerrar notificación de correcciones" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Panel.ZIndex="200" Background="#F3F7F9"
              Visibility="{Binding Station.IsInitialSyncActive, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="570" Padding="38" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="White" BorderBrush="#D7E3E8" BorderThickness="1" CornerRadius="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.14" Color="#173B50" />
                </Border.Effect>
                <StackPanel>
                    <Border Width="78" Height="78" HorizontalAlignment="Center"
                            CornerRadius="22" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/logo-industrias-doradas.png"
                               Stretch="UniformToFill"
                               AutomationProperties.Name="Logo de Industrias Doradas" />
                    </Border>
                    <TextBlock Margin="0,20,0,0" HorizontalAlignment="Center"
                               Foreground="#176A8A" FontSize="11" FontWeight="Bold"
                               Text="PREPARANDO ESTACIÓN" />
                    <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center"
                               Foreground="{StaticResource Ink900Brush}" FontSize="28" FontWeight="Bold"
                               Text="Actualizando datos locales" />
                    <TextBlock Margin="18,10,18,0" MinHeight="42" HorizontalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" FontSize="14"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Text="{Binding Station.InitialSyncStatus}" />
                    <ProgressBar Height="12" Margin="0,22,0,0" Minimum="0" Maximum="100"
                                 Value="{Binding Station.InitialSyncProgress, Mode=OneWay}"
                                 IsIndeterminate="{Binding Station.InitialSyncIndeterminate}"
                                 Foreground="#D89B18" Background="#E8EFF2"
                                 AutomationProperties.Name="Progreso de sincronización inicial" />
                    <TextBlock Margin="0,15,0,0" HorizontalAlignment="Center"
                               Foreground="#6E7F88" FontSize="11" TextAlignment="Center"
                               Text="Espere un momento. No cierre la aplicación durante esta preparación." />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ElevationOverlay" Panel.ZIndex="100" Visibility="Collapsed"
              Background="#A6162F40">
            <Border Width="450" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="White" CornerRadius="22">
                <StackPanel>
                    <Border Width="76" Height="76" HorizontalAlignment="Center"
                            Background="#EAF3F7" CornerRadius="38">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="Segoe UI Emoji" FontSize="35" Text="🔐" />
                    </Border>
                    <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center"
                               FontSize="24" FontWeight="Bold" Text="Elevación temporal" />
                    <TextBlock Margin="0,8,0,18" Foreground="{StaticResource MutedBrush}"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Text="Ingrese el PIN individual del jefe de planta. El acceso vuelve al modo normal después de cinco minutos de inactividad." />
                    <PasswordBox x:Name="HeaderPinBox" Height="54" MaxLength="12"
                                 Padding="13" FontSize="22" KeyDown="OnElevationPinKeyDown"
                                 AutomationProperties.Name="PIN individual" />
                    <Border Margin="0,10,0,0" Padding="13,10" Background="#F2F7F9"
                            BorderBrush="#D5E3E9" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontFamily="Segoe UI Emoji"
                                       FontSize="22" Text="◉" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Foreground="#0874A3" FontSize="10" FontWeight="Bold"
                                           Text="BIOMETRÍA LOCAL · PROTOTIPO" />
                                <TextBlock x:Name="BiometricStatusText" Margin="0,2,0,0"
                                           Foreground="#536A77" TextWrapping="Wrap"
                                           Text="Comprobando registro facial…" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button x:Name="EnrollBiometricButton" Margin="0,8,0,0" Height="44"
                            Click="OnEnrollBiometric" Visibility="Collapsed"
                            Content="REGISTRAR ROSTRO EN ESTE EQUIPO" />
                    <StackPanel Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Click="OnCancelElevation" Content="CANCELAR" />
                        <Button Margin="10,0,0,0" Click="OnElevate"
                                Background="{StaticResource NavyBrush}" BorderBrush="{StaticResource NavyBrush}"
                                Foreground="White" Content="AUTORIZAR"
                                IsEnabled="{Binding Station.CanInteract}" />
                    </StackPanel>
                    <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" Text="{Binding Station.Status}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="SessionRestoreNotice" Panel.ZIndex="120" Visibility="Collapsed"
                Style="{StaticResource SuccessAlertStyle}"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,92,0,0"
                Padding="18,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="#176B3B" FontWeight="Bold"
                           Text="✓  Se encontró una sesión activa y se restauró automáticamente." />
                <Button Margin="14,-7,-9,-7" MinHeight="0" Padding="8,3"
                        Background="Transparent" BorderThickness="0" Foreground="#176B3B"
                        Click="OnDismissRestoreNotice" Content="×" />
            </StackPanel>
        </Border>

        <Border x:Name="ComingSoonNotice" Panel.ZIndex="130" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
                Padding="18,13" Background="#173B50" CornerRadius="12">
            <TextBlock x:Name="ComingSoonText" Foreground="White" FontWeight="SemiBold"
                       Text="Función disponible próximamente." />
        </Border>
    </Grid>
</Window>
