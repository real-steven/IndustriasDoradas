<Window x:Class="IndustriasDoradas.Desktop.Presentation.BiometricEnrollmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar rostro · Industrias Doradas"
        Width="720" Height="660" MinWidth="620" MinHeight="580"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F3F7F8">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Foreground="#0874A3" FontSize="12" FontWeight="Bold"
                       Text="REGISTRO BIOMÉTRICO LOCAL" />
            <TextBlock Margin="0,6,0,0" FontSize="28" FontWeight="Bold"
                       Text="Centre su rostro" />
            <TextBlock Margin="0,6,0,0" Foreground="#637986" FontSize="14"
                       TextWrapping="Wrap"
                       Text="Mire al frente y mantenga una iluminación uniforme. La cámara se apagará al terminar y no se guardarán fotografías." />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,20" Background="#142F40" CornerRadius="20"
                BorderBrush="#D0E0E6" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Image x:Name="CameraPreview" Stretch="UniformToFill"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform ScaleX="-1" />
                    </Image.RenderTransform>
                </Image>
                <Grid IsHitTestVisible="False">
                    <Ellipse Width="265" Height="350" HorizontalAlignment="Center"
                             VerticalAlignment="Center" Stroke="#E3AF30" StrokeThickness="4"
                             StrokeDashArray="4 3" Fill="#08000000" />
                    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,24" Padding="14,8" Background="#B3122A38"
                            CornerRadius="10">
                        <TextBlock Foreground="White" FontWeight="SemiBold"
                                   Text="Una sola persona frente a la cámara" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="EnrollmentStatus" Foreground="#173B50"
                           FontWeight="SemiBold" Text="Preparando cámara…" />
                <TextBlock Margin="0,3,0,0" Foreground="#6E7F88" FontSize="11"
                           Text="La plantilla facial queda cifrada únicamente en esta estación." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CancelButton" MinWidth="105" Height="44" Padding="16,8"
                        Click="OnCancel" Content="CANCELAR" />
                <Button x:Name="DoneButton" MinWidth="105" Height="44" Margin="10,0,0,0"
                        Padding="16,8" Click="OnDone" Visibility="Collapsed"
                        Background="#173B50" BorderBrush="#173B50" Foreground="White"
                        Content="LISTO" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
