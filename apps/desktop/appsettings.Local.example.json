{
  "Api": {
    "BaseUrl": "https://YOUR_API_HOST/",
    "RequestTimeoutSeconds": 5
  },
  "Supabase": {
    "Url": "https://YOUR_PROJECT.supabase.co/",
    "PublishableKey": "sb_publishable_YOUR_PUBLIC_KEY",
    "RequestTimeoutSeconds": 10
  },
  "Station": {
    "Id": "34000000-0000-4000-8000-000000000001",
    "SessionIdleSeconds": 3600,
    "PrivilegedIdleSeconds": 300,
    "OfflineHours": 24
  },
  "OperationInput": {
    "Controllers": [
      {
        "Id": "shared-keyboard",
        "AdapterKind": "KEYBOARD",
        "LineSlot": 1,
        "Bindings": {
          "D1": "SelectLine:1",
          "Add": "RegisterCajuela",
          "OemPlus": "RegisterCajuela",
          "Up": "MoveUp",
          "Down": "MoveDown",
          "Left": "MoveLeft",
          "Right": "MoveRight",
          "Return": "Confirm",
          "R": "RevertLastCajuela",
          "Escape": "Cancel"
        }
      }
    ]
  },
  "OperationSafety": {
    "DebounceMilliseconds": 75,
    "RegistrationCooldownMilliseconds": 3000,
    "VisualFeedbackEnabled": true,
    "SoundFeedbackEnabled": true,
    "MetricsEnabled": true,
    "MetricsQueueCapacity": 1000
  },
  "LocalRecovery": {
    "MinimumFreeMegabytes": 256
  },
  "Sync": {
    "BatchSize": 10,
    "RequestTimeoutSeconds": 30,
    "PollIntervalSeconds": 5,
    "LeaseSeconds": 60,
    "BaseRetrySeconds": 2,
    "MaximumRetrySeconds": 300,
    "JitterRatio": 0.25
  }
}
